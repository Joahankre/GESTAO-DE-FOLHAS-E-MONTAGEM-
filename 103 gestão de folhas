'################################################################
' ARQUIVOS COM VISTAS
'################################################################

Function ObterArquivosComVistas(
    drawingDoc As DrawingDocument) As HashSet(Of String)


    Dim resultado As New HashSet(
        Of String)(
        StringComparer.OrdinalIgnoreCase)


    For Each folha As Sheet In
        drawingDoc.Sheets


        For Each vista As DrawingView In
            folha.DrawingViews


            Try

                Dim doc =
                    vista.
                    ReferencedDocumentDescriptor.
                    ReferencedDocument


                If doc IsNot Nothing AndAlso
                   Not String.IsNullOrWhiteSpace(
                       doc.FullFileName) Then


                    resultado.Add(
                        doc.FullFileName)

                End If


            Catch

            End Try

        Next

    Next


    Return resultado

End Function


'################################################################
' COPIAR FOLHAS
'################################################################

Sub CopiarFolhasSelecionadas(
    listView As ListView,
    drawingDoc As DrawingDocument)


    Dim nomes =
        listView.CheckedItems.
        Cast(Of ListViewItem)().
        Select(
            Function(x)
                Return x.Text
            End Function).
        ToList()


    If nomes.Count = 0 Then


        MessageBox.Show(
            "Selecione ao menos uma folha para copiar.",
            "Aviso",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)


        Return

    End If


    For Each nome In nomes


        Try

            Dim folha As Sheet =
                drawingDoc.
                Sheets.
                Item(nome)


            folha.CopyTo(
                drawingDoc)


        Catch ex As Exception


            MessageBox.Show(
                "Erro ao copiar '" &
                nome &
                "':" &
                vbCrLf &
                ex.Message,
                "Erro",
                MessageBoxButtons.OK,
                MessageBoxIcon.Error)


        End Try

    Next


    drawingDoc.Update()

End Sub


'################################################################
' EXCLUIR FOLHAS
'################################################################

Sub ExcluirFolhasSelecionadas(
    listView As ListView,
    drawingDoc As DrawingDocument)


    Dim nomes =
        listView.CheckedItems.
        Cast(Of ListViewItem)().
        Select(
            Function(x)
                Return x.Text
            End Function).
        ToList()


    If nomes.Count = 0 Then


        MessageBox.Show(
            "Selecione ao menos uma folha para excluir.",
            "Aviso",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)


        Return

    End If


    Dim resposta =
        MessageBox.Show(
            "Tem certeza que deseja excluir as folhas selecionadas?" &
            vbCrLf &
            "Essa ação não pode ser desfeita.",
            "Confirmar Exclusão",
            MessageBoxButtons.YesNo,
            MessageBoxIcon.Warning)


    If resposta <> DialogResult.Yes Then
        Return
    End If


    For i As Integer =
        drawingDoc.Sheets.Count To 1 Step -1


        Dim folha As Sheet =
            drawingDoc.
            Sheets.
            Item(i)


        If nomes.Contains(
            folha.Name,
            StringComparer.OrdinalIgnoreCase) Then


            Try

                folha.Delete()

            Catch ex As Exception


                MessageBox.Show(
                    "Erro ao excluir '" &
                    folha.Name &
                    "':" &
                    vbCrLf &
                    ex.Message,
                    "Erro",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error)


            End Try

        End If

    Next


    drawingDoc.Update()

End Sub


'################################################################
' ESCALA
'################################################################

Private Function CalcularEscalaIdeal(
    compDef As ComponentDefinition) As Double


    Try

        Dim box As Box =
            compDef.RangeBox


        Dim largura As Double =
            Math.Abs(
                box.MaxPoint.X -
                box.MinPoint.X)


        Dim altura As Double =
            Math.Abs(
                box.MaxPoint.Y -
                box.MinPoint.Y)


        Dim profundidade As Double =
            Math.Abs(
                box.MaxPoint.Z -
                box.MinPoint.Z)


        Dim maior As Double =
            Math.Max(
                largura,
                Math.Max(
                    altura,
                    profundidade)) * 10


        If maior <= 0 Then
            Return 1
        End If


        Dim escala As Double =
            180 / maior


        If escala >= 1 Then Return 1
        If escala >= 0.5 Then Return 0.5
        If escala >= 0.2 Then Return 0.2
        If escala >= 0.1 Then Return 0.1


        Return 0.05


    Catch

        Return 1

    End Try

End Function


'################################################################
' ESCALA FLAT PATTERN
'################################################################

Private Function CalcularEscalaFlatPattern(
    smDef As SheetMetalComponentDefinition) As Double


    Try

        If Not smDef.HasFlatPattern Then

            smDef.Unfold()

        End If


        Dim box As Box =
            smDef.FlatPattern.RangeBox


        Dim largura As Double =
            Math.Abs(
                box.MaxPoint.X -
                box.MinPoint.X)


        Dim altura As Double =
            Math.Abs(
                box.MaxPoint.Y -
                box.MinPoint.Y)


        Dim maior As Double =
            Math.Max(
                largura,
                altura) * 10


        If maior <= 0 Then
            Return 0.1
        End If


        Dim escala As Double =
            180 / maior


        If escala >= 1 Then Return 1
        If escala >= 0.5 Then Return 0.5
        If escala >= 0.2 Then Return 0.2
        If escala >= 0.1 Then Return 0.1
        If escala >= 0.05 Then Return 0.05


        Return 0.02


    Catch

        Return 0.1

    End Try

End Function


'################################################################
' INSERIR VISTA
'################################################################

Sub InsertBaseViewUsingCopiedSheet(
    drawingDoc As DrawingDocument,
    partPath As String,
    itemNumber As String,
    labelNumber As String,
    arquivosComVistas As HashSet(Of String))


    If arquivosComVistas.Contains(
        partPath) Then

        Return

    End If


    Dim partDoc As Document =
        Nothing


    Try


        '-----------------------------------------------------
        ' ABRIR DOCUMENTO
        '-----------------------------------------------------

        partDoc =
            ThisApplication.Documents.Open(
                partPath,
                False)


        '-----------------------------------------------------
        ' CRIAR FOLHA
        '-----------------------------------------------------

        Dim nomeFolha As String =
            SanitizarNomeFolha(
                itemNumber &
                " – " &
                labelNumber)


        Dim novaFolha As Sheet =
            drawingDoc.
            Sheets.
            Add(
                DrawingSheetSizeEnum.kA3DrawingSheetSize,
                PageOrientationTypeEnum.kLandscapePageOrientation,
                nomeFolha)


        novaFolha.Activate()


        '-----------------------------------------------------
        ' MARGEM
        '-----------------------------------------------------

        Try


            Dim margemDef As BorderDefinition =
                drawingDoc.
                BorderDefinitions.
                Item("FOLHA DOMA/LIGA")


            If novaFolha.Border IsNot Nothing Then

                novaFolha.Border.Delete()

            End If


            novaFolha.AddBorder(
                margemDef)


        Catch

        End Try


        '-----------------------------------------------------
        ' LEGENDA
        '-----------------------------------------------------

        Try


            Dim titleDef As TitleBlockDefinition =
                drawingDoc.
                TitleBlockDefinitions.
                Item("SELO DOMA/LIGA")


            If novaFolha.TitleBlock IsNot Nothing Then

                novaFolha.TitleBlock.Delete()

            End If


            novaFolha.AddTitleBlock(
                titleDef)


        Catch

        End Try


        '-----------------------------------------------------
        ' GEOMETRIA
        '-----------------------------------------------------

        Dim tg As TransientGeometry =
            ThisApplication.
            TransientGeometry


        Dim escala As Double =
            1


        If TypeOf partDoc Is PartDocument Then


            escala =
                CalcularEscalaIdeal(
                    CType(
                        partDoc,
                        PartDocument).
                    ComponentDefinition)


        ElseIf TypeOf partDoc Is AssemblyDocument Then


            escala =
                CalcularEscalaIdeal(
                    CType(
                        partDoc,
                        AssemblyDocument).
                    ComponentDefinition)


        End If


        Dim pos As Point2d =
            tg.CreatePoint2d(
                novaFolha.Width / 4,
                novaFolha.Height / 2)


        '-----------------------------------------------------
        ' VISTA PRINCIPAL
        '-----------------------------------------------------

        Dim vista As DrawingView =
            novaFolha.
            DrawingViews.
            AddBaseView(
                partDoc,
                pos,
                escala,
                ViewOrientationTypeEnum.kDefaultViewOrientation,
                DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle)


        vista.DisplayTangentEdges =
            True


        '-----------------------------------------------------
        ' SOMENTE SHEET METAL
        '-----------------------------------------------------

        If Not TypeOf partDoc Is PartDocument Then


            drawingDoc.Update()


            partDoc.Close(
                False)


            Return

        End If


        Dim smDef As SheetMetalComponentDefinition =
            Nothing


        Try


            smDef =
                CType(
                    CType(
                        partDoc,
                        PartDocument).
                    ComponentDefinition,
                    SheetMetalComponentDefinition)


        Catch


            partDoc.Close(
                False)


            Return

        End Try


        If smDef.Bends.Count = 0 Then


            partDoc.Close(
                False)


            Return

        End If


        '-----------------------------------------------------
        ' FLAT PATTERN
        '-----------------------------------------------------

        If Not smDef.HasFlatPattern Then

            smDef.Unfold()

        End If


        Try

            CType(
                partDoc,
                PartDocument).
                Update()

        Catch

        End Try


        Dim escalaFlat As Double =
            CalcularEscalaFlatPattern(
                smDef)


        Dim posFlat As Point2d =
            tg.CreatePoint2d(
                novaFolha.Width * 0.75,
                novaFolha.Height / 2)


        Dim options As NameValueMap =
            ThisApplication.
            TransientObjects.
            CreateNameValueMap()


        options.Add(
            "SheetMetalFoldedModel",
            False)


        Dim vistaFlat As DrawingView =
            novaFolha.
            DrawingViews.
            AddBaseView(
                partDoc,
                posFlat,
                escalaFlat,
                ViewOrientationTypeEnum.kDefaultViewOrientation,
                DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle,
                "",
                Nothing,
                options)


        vistaFlat.DisplayTangentEdges =
            True


        drawingDoc.Update()


        '-----------------------------------------------------
        ' NOTAS DE DOBRA
        '-----------------------------------------------------

        Dim pontosProcessados As New List(Of Point2d)

        Dim tolerancia As Double =
            0.01


        For Each curva As DrawingCurve In
            vistaFlat.DrawingCurves


            Try


                If curva.EdgeType =
                   DrawingEdgeTypeEnum.kBendUpEdge OrElse
                   curva.EdgeType =
                   DrawingEdgeTypeEnum.kBendDownEdge Then


                    Dim ponto As Point2d =
                        curva.MidPoint


                    Dim duplicada As Boolean =
                        False


                    For Each anterior As Point2d In
                        pontosProcessados


                        Dim dx As Double =
                            ponto.X -
                            anterior.X


                        Dim dy As Double =
                            ponto.Y -
                            anterior.Y


                        Dim distancia As Double =
                            Math.Sqrt(
                                dx * dx +
                                dy * dy)


                        If distancia <= tolerancia Then


                            duplicada =
                                True


                            Exit For


                        End If


                    Next


                    If Not duplicada Then


                        Dim nota As BendNote =
                            novaFolha.
                            DrawingNotes.
                            BendNotes.
                            Add(curva)


                        nota.Position =
                            tg.CreatePoint2d(
                                ponto.X,
                                ponto.Y)


                        pontosProcessados.Add(
                            tg.CreatePoint2d(
                                ponto.X,
                                ponto.Y))


                    End If


                End If


            Catch

            End Try


        Next


        drawingDoc.Update()


        partDoc.Close(
            False)


    Catch ex As Exception


        MessageBox.Show(
            "Erro ao inserir vista:" &
            vbCrLf &
            ex.Message,
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)


        Try


            If partDoc IsNot Nothing Then

                partDoc.Close(
                    False)

            End If


        Catch

        End Try


    End Try

End Sub


'################################################################
' SANITIZAR NOME
'################################################################

Function SanitizarNomeFolha(
    nome As String) As String


    Dim caracteresInvalidos() As Char = {
        "<"c,
        ">"c,
        ":"c,
        """"c,
        "/"c,
        "\"c,
        "|"c,
        "?"c,
        "*"c,
        ","c
    }


    For Each c In
        caracteresInvalidos


        nome =
            nome.Replace(
                c,
                "."c)


    Next


    Return nome.Trim()

End Function
