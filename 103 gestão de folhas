Imports System.Windows.Forms
Imports Inventor
Imports System.Drawing
Imports System.Linq
Imports System.Collections.Generic

'=========================================================
' CACHE DE REFERÊNCIAS DO DESENHO
'=========================================================

Public Class FolhaCache
    Public Nome As String
    Public Status As String = "🚫 Vazia"
    Public QtdePersonalizada As String = "-"
    Public ArquivosReferenciados As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
End Class

Public Class DrawingCache
    Public MapaVistas As New Dictionary(Of String, List(Of String))(StringComparer.OrdinalIgnoreCase)
    Public Folhas As New Dictionary(Of String, FolhaCache)(StringComparer.OrdinalIgnoreCase)
    Public ArquivosComVistas As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
End Class

Sub Main()

    '=========================================================
    ' VERIFICAÇÃO DO DOCUMENTO ATIVO
    '=========================================================

    If ThisApplication.ActiveDocument Is Nothing OrElse
       ThisApplication.ActiveDocument.DocumentType <> DocumentTypeEnum.kDrawingDocumentObject Then

        MessageBox.Show(
            "Este script deve ser executado em um documento de desenho (.idw).",
            "Documento inválido",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)

        Return
    End If

    Dim drawingDoc As DrawingDocument =
        CType(ThisApplication.ActiveDocument, DrawingDocument)

    Dim assemblyDoc As AssemblyDocument =
        GetAssemblyFromFirstSheet(drawingDoc)

    Dim bomRows As BOMRowsEnumerator =
        If(assemblyDoc IsNot Nothing, GetBOMRows(drawingDoc), Nothing)

    '=========================================================
    ' CONSTRUIR CACHE INICIAL
    '=========================================================

    Dim cache As DrawingCache =
        ConstruirCache(drawingDoc)

    '=========================================================
    ' FORMULÁRIO
    '=========================================================

    Dim form As New Form() With {
        .Text = "Developed by Kreimeier & Machado - Gestão de Páginas de Desenho",
        .Width = 1400,
        .Height = 800,
        .StartPosition = FormStartPosition.CenterScreen
    }

    '=========================================================
    ' SPLIT CONTAINER
    '=========================================================

    Dim splitContainer As New SplitContainer() With {
        .Dock = DockStyle.Fill,
        .Orientation = Orientation.Vertical,
        .SplitterWidth = 1
    }

    splitContainer.SplitterDistance = CInt(form.Width * 0.055)
    form.Controls.Add(splitContainer)

    '=========================================================
    ' PAINEL ESQUERDO — BOM
    '=========================================================

    Dim panelEsqLayout As New TableLayoutPanel() With {
        .Dock = DockStyle.Fill,
        .RowCount = 2
    }

    panelEsqLayout.RowStyles.Add(New RowStyle(SizeType.Percent, 100))
    panelEsqLayout.RowStyles.Add(New RowStyle(SizeType.Absolute, 100))

    splitContainer.Panel1.Controls.Add(panelEsqLayout)

    '=========================================================
    ' TREEVIEW
    '=========================================================

    Dim treeView As New TreeView() With {
        .Dock = DockStyle.Fill,
        .CheckBoxes = True,
        .HideSelection = False
    }

    panelEsqLayout.Controls.Add(treeView, 0, 0)

    '=========================================================
    ' BOTÕES BOM
    '=========================================================

    Dim panelEsqBottom As New FlowLayoutPanel() With {
        .Dock = DockStyle.Fill,
        .FlowDirection = FlowDirection.LeftToRight,
        .AutoScroll = True
    }

    Dim btnInsert As New Button() With {.Text = "Inserir Vistas", .Width = 200}
    Dim btnExpandir As New Button() With {.Text = "Expandir", .Width = 100}
    Dim btnContrair As New Button() With {.Text = "Contrair", .Width = 100}
    Dim btnSelecionarTudo As New Button() With {.Text = "Selecionar Tudo", .Width = 140}
    Dim btnDesmarcarTudo As New Button() With {.Text = "Desmarcar Tudo", .Width = 140}
    Dim btnAtualizarStatus As New Button() With {.Text = "Atualizar BOM", .Width = 140}

    panelEsqBottom.Controls.AddRange({
        btnInsert,
        btnExpandir,
        btnContrair,
        btnSelecionarTudo,
        btnDesmarcarTudo,
        btnAtualizarStatus
    })

    panelEsqLayout.Controls.Add(panelEsqBottom, 0, 1)

    '=========================================================
    ' PREENCHER TREEVIEW USANDO O CACHE
    '=========================================================

    PreencherTreeView(treeView, bomRows, cache)

    '=========================================================
    ' PAINEL DIREITO — FOLHAS
    '=========================================================

    Dim panelDirLayout As New TableLayoutPanel() With {
        .Dock = DockStyle.Fill,
        .RowCount = 2
    }

    panelDirLayout.RowStyles.Add(New RowStyle(SizeType.Percent, 100))
    panelDirLayout.RowStyles.Add(New RowStyle(SizeType.Absolute, 100))

    splitContainer.Panel2.Controls.Add(panelDirLayout)

    '=========================================================
    ' LISTVIEW
    '=========================================================

    Dim sheetListView As New ListView() With {
        .Dock = DockStyle.Fill,
        .CheckBoxes = True,
        .View = System.Windows.Forms.View.Details,
        .FullRowSelect = True,
        .GridLines = True,
        .BorderStyle = BorderStyle.FixedSingle,
        .HideSelection = False
    }

    sheetListView.Columns.Add("Folha", 300, HorizontalAlignment.Left)
    sheetListView.Columns.Add("Conferência", 200, HorizontalAlignment.Center)
    sheetListView.Columns.Add("QTDE PERSONALIZADA", 180, HorizontalAlignment.Center)

    panelDirLayout.Controls.Add(sheetListView, 0, 0)

    '=========================================================
    ' BOTÕES FOLHAS
    '=========================================================

    Dim panelDirBottom As New FlowLayoutPanel() With {
        .Dock = DockStyle.Fill,
        .FlowDirection = FlowDirection.RightToLeft,
        .AutoScroll = True
    }

    Dim btnSelectAll As New Button() With {.Text = "Selecionar Todas", .Width = 160}
    Dim btnDeselectAll As New Button() With {.Text = "Desmarcar Todas", .Width = 160}
    Dim btnSelectByPrefix As New Button() With {.Text = "Selecionar por Prefixo", .Width = 180}
    Dim btnAtualizarFolhas As New Button() With {.Text = "Atualizar Folhas", .Width = 160}
    Dim btnExcluirFolhas As New Button() With {.Text = "Excluir Selecionadas", .Width = 200}
    Dim btnCopiarFolhas As New Button() With {.Text = "Copiar Selecionadas", .Width = 200}

    panelDirBottom.Controls.AddRange({
        btnCopiarFolhas,
        btnExcluirFolhas,
        btnAtualizarFolhas,
        btnSelectByPrefix,
        btnDeselectAll,
        btnSelectAll
    })

    panelDirLayout.Controls.Add(panelDirBottom, 0, 1)

    '=========================================================
    ' INICIALIZAR LISTA USANDO O CACHE
    '=========================================================

    AtualizarListaDeFolhas(sheetListView, drawingDoc, cache)

    '=========================================================
    ' SELEÇÃO POR SHIFT — TREEVIEW
    '=========================================================

    Dim ultimoNoTree As TreeNode = Nothing

    AddHandler treeView.NodeMouseClick,
        Sub(sender As Object, e As TreeNodeMouseClickEventArgs)

            If e.Node Is Nothing Then Return

            Dim shiftPressed As Boolean =
                (Control.ModifierKeys And Keys.Shift) = Keys.Shift

            Dim ctrlPressed As Boolean =
                (Control.ModifierKeys And Keys.Control) = Keys.Control

            If shiftPressed AndAlso ultimoNoTree IsNot Nothing Then

                SelecionarIntervaloTreeView(treeView, ultimoNoTree, e.Node)

            ElseIf Not ctrlPressed Then

                ultimoNoTree = e.Node

            Else

                ultimoNoTree = e.Node

            End If

        End Sub

    '=========================================================
    ' SELEÇÃO POR SHIFT — LISTVIEW
    '=========================================================

    Dim ultimoItemList As ListViewItem = Nothing

    AddHandler sheetListView.MouseDown,
        Sub(sender As Object, e As MouseEventArgs)

            If e.Button <> MouseButtons.Left Then Return

            Dim item As ListViewItem =
                sheetListView.GetItemAt(e.X, e.Y)

            If item Is Nothing Then Return

            Dim shiftPressed As Boolean =
                (Control.ModifierKeys And Keys.Shift) = Keys.Shift

            Dim ctrlPressed As Boolean =
                (Control.ModifierKeys And Keys.Control) = Keys.Control

            If shiftPressed AndAlso ultimoItemList IsNot Nothing Then

                SelecionarIntervaloListView(sheetListView, ultimoItemList, item)

            ElseIf Not ctrlPressed Then

                ultimoItemList = item

            Else

                ultimoItemList = item

            End If

        End Sub

    '=========================================================
    ' INSERIR VISTAS
    '=========================================================

    AddHandler btnInsert.Click,
        Sub()

            Dim nodesSelecionados =
                GetCheckedNodes(treeView.Nodes)

            If nodesSelecionados.Count = 0 Then

                MessageBox.Show(
                    "Selecione ao menos um item na BOM.",
                    "Aviso",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

                Return
            End If

            ' Cópia do conjunto do cache:
            ' evita consultar novamente todas as folhas.

            Dim arquivosComVistas As New HashSet(Of String)(
                cache.ArquivosComVistas,
                StringComparer.OrdinalIgnoreCase)

            For Each node As TreeNode In nodesSelecionados

                Dim tag =
                    TryCast(node.Tag, Tuple(Of String, String, String))

                If tag IsNot Nothing AndAlso
                   Not String.IsNullOrWhiteSpace(tag.Item1) Then

                    InsertBaseViewUsingCopiedSheet(
                        drawingDoc,
                        tag.Item1,
                        tag.Item2,
                        tag.Item3,
                        arquivosComVistas)

                    ' Impede tentativa repetida para o mesmo arquivo
                    ' durante esta operação.

                    arquivosComVistas.Add(tag.Item1)

                End If

            Next

            ' As vistas foram alteradas: reconstruir o cache.

            AtualizarFolhasEBOM(
                sheetListView,
                treeView,
                drawingDoc,
                cache)

        End Sub

    '=========================================================
    ' ATUALIZAR FOLHAS + BOM
    '=========================================================

    AddHandler btnAtualizarFolhas.Click,
        Sub()

            AtualizarFolhasEBOM(
                sheetListView,
                treeView,
                drawingDoc,
                cache)

        End Sub

    '=========================================================
    ' ATUALIZAR BOM
    '=========================================================

    AddHandler btnAtualizarStatus.Click,
        Sub()

            AtualizarFolhasEBOM(
                sheetListView,
                treeView,
                drawingDoc,
                cache)

        End Sub

    '=========================================================
    ' COPIAR FOLHAS
    '=========================================================

    AddHandler btnCopiarFolhas.Click,
        Sub()

            CopiarFolhasSelecionadas(
                sheetListView,
                drawingDoc)

            AtualizarFolhasEBOM(
                sheetListView,
                treeView,
                drawingDoc,
                cache)

        End Sub

    '=========================================================
    ' EXCLUIR FOLHAS
    '=========================================================

    AddHandler btnExcluirFolhas.Click,
        Sub()

            ExcluirFolhasSelecionadas(
                sheetListView,
                drawingDoc)

            AtualizarFolhasEBOM(
                sheetListView,
                treeView,
                drawingDoc,
                cache)

        End Sub

    '=========================================================
    ' SELECIONAR TODAS AS FOLHAS
    '=========================================================

    AddHandler btnSelectAll.Click,
        Sub()

            For Each item As ListViewItem In sheetListView.Items
                item.Checked = True
            Next

        End Sub

    '=========================================================
    ' DESMARCAR TODAS AS FOLHAS
    '=========================================================

    AddHandler btnDeselectAll.Click,
        Sub()

            For Each item As ListViewItem In sheetListView.Items
                item.Checked = False
            Next

        End Sub

    '=========================================================
    ' SELECIONAR POR PREFIXO
    '=========================================================

    AddHandler btnSelectByPrefix.Click,
        Sub()

            Dim prefixo As String =
                InputBox("Digite o prefixo:", "Selecionar por Prefixo")

            If String.IsNullOrWhiteSpace(prefixo) Then Return

            If prefixo.Length < 2 Then

                MessageBox.Show(
                    "Digite ao menos 2 caracteres.",
                    "Prefixo inválido",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

                Return
            End If

            For Each item As ListViewItem In sheetListView.Items

                If item.Text.ToUpperInvariant().StartsWith(
                    prefixo.ToUpperInvariant()) Then

                    item.Checked = True

                End If

            Next

        End Sub

    '=========================================================
    ' EXPANDIR / CONTRAIR
    '=========================================================

    AddHandler btnExpandir.Click,
        Sub()
            treeView.ExpandAll()
        End Sub

    AddHandler btnContrair.Click,
        Sub()
            treeView.CollapseAll()
        End Sub

    '=========================================================
    ' SELECIONAR / DESMARCAR TODA BOM
    '=========================================================

    AddHandler btnSelecionarTudo.Click,
        Sub()
            SetCheckState(treeView.Nodes, True)
        End Sub

    AddHandler btnDesmarcarTudo.Click,
        Sub()
            SetCheckState(treeView.Nodes, False)
        End Sub

    '=========================================================
    ' MOSTRAR
    '=========================================================

    form.ShowDialog()

End Sub



'################################################################
' CONSTRUIR CACHE DO DESENHO
'################################################################

Function ConstruirCache(
    drawingDoc As DrawingDocument) As DrawingCache

    Dim cache As New DrawingCache

    If drawingDoc Is Nothing Then Return cache

    '---------------------------------------------------------
    ' PRIMEIRA PASSAGEM:
    ' Construir o mapa completo de arquivos e folhas.
    '---------------------------------------------------------

    For Each folha As Sheet In drawingDoc.Sheets

        Dim folhaInfo As New FolhaCache
        folhaInfo.Nome = folha.Name

        Dim primeiroDocumentoComPropriedade As Boolean = False

        For Each vista As DrawingView In folha.DrawingViews

            Dim doc As Document = Nothing

            Try
                doc = vista.ReferencedDocumentDescriptor.ReferencedDocument
            Catch
                Continue For
            End Try

            If doc Is Nothing Then Continue For

            Dim caminho As String = ""

            Try
                caminho = doc.FullFileName
            Catch
                Continue For
            End Try

            If String.IsNullOrWhiteSpace(caminho) Then Continue For

            folhaInfo.ArquivosReferenciados.Add(caminho)
            cache.ArquivosComVistas.Add(caminho)

            Dim nomesFolhas As List(Of String) = Nothing

            If Not cache.MapaVistas.TryGetValue(caminho, nomesFolhas) Then

                nomesFolhas = New List(Of String)
                cache.MapaVistas.Add(caminho, nomesFolhas)

            End If

            If Not nomesFolhas.Contains(
                folha.Name,
                StringComparer.OrdinalIgnoreCase) Then

                nomesFolhas.Add(folha.Name)

            End If

            '-------------------------------------------------
            ' QTDE PERSONALIZADA
            ' Mantém o comportamento original.
            '-------------------------------------------------

            If Not primeiroDocumentoComPropriedade Then

                Try

                    Dim props As PropertySet =
                        doc.PropertySets.Item(
                            "Inventor User Defined Properties")

                    Try

                        Dim prop As Inventor.Property =
                            props.Item("QTDE PERSONALIZADA")

                        If prop IsNot Nothing AndAlso
                           prop.Value IsNot Nothing Then

                            folhaInfo.QtdePersonalizada =
                                prop.Value.ToString()

                        End If

                    Catch
                    End Try

                    primeiroDocumentoComPropriedade = True

                Catch
                End Try

            End If

        Next

        cache.Folhas(folha.Name) = folhaInfo

    Next

    '---------------------------------------------------------
    ' SEGUNDA PASSAGEM:
    ' Agora o mapa está completo.
    ' Calcular o status de cada folha.
    '---------------------------------------------------------

    For Each folha As Sheet In drawingDoc.Sheets

        Dim folhaInfo As FolhaCache = Nothing

        If Not cache.Folhas.TryGetValue(
            folha.Name,
            folhaInfo) Then

            Continue For

        End If

        If folhaInfo.ArquivosReferenciados.Count = 0 Then

            folhaInfo.Status = "🚫 Vazia"
            Continue For

        End If

        Dim todasPaginas As New List(Of String)

        For Each arquivo As String In folhaInfo.ArquivosReferenciados

            Dim nomesFolhas As List(Of String) = Nothing

            If cache.MapaVistas.TryGetValue(
                arquivo,
                nomesFolhas) Then

                todasPaginas.AddRange(nomesFolhas)

            End If

        Next

        ' Remover duplicadas e ordenar numericamente.

        Dim paginasNumericas As New List(Of Integer)

        For Each nomeFolha As String In todasPaginas

            Dim numero As Integer

            If Integer.TryParse(
                ExtrairNumeroPagina(nomeFolha),
                numero) Then

                If Not paginasNumericas.Contains(numero) Then
                    paginasNumericas.Add(numero)
                End If

            End If

        Next

        paginasNumericas.Sort()

        If paginasNumericas.Count = 0 Then

            folhaInfo.Status = "🚫"

        Else

            Dim paginasFormatadas As New List(Of String)

            For Each numero As Integer In paginasNumericas
                paginasFormatadas.Add(numero.ToString())
            Next

            Dim textoPaginas As String =
                String.Join(". ", paginasFormatadas.ToArray())

            If paginasNumericas.Count = 1 Then

                folhaInfo.Status =
                    "✔️ Pág: " & textoPaginas

            Else

                folhaInfo.Status =
                    "🔁 Pág: " & textoPaginas

            End If

        End If

    Next

    Return cache

End Function



'################################################################
' PREENCHER TREEVIEW COM CACHE
'################################################################

Sub PreencherTreeView(
    treeView As TreeView,
    bomRows As BOMRowsEnumerator,
    cache As DrawingCache)

    treeView.BeginUpdate()

    Try

        treeView.Nodes.Clear()

        If bomRows Is Nothing Then Return

        If cache Is Nothing Then
            cache = New DrawingCache
        End If

        For Each row As BOMRow In bomRows

            AddBOMRowNode(
                Row,
                treeView.Nodes,
                cache)

        Next

        OrdenarTreeNodes(treeView.Nodes)
        treeView.ExpandAll()

    Finally

        treeView.EndUpdate()

    End Try

End Sub

'################################################################
' ADICIONAR NÓ BOM USANDO CACHE
'################################################################

Sub AddBOMRowNode(
    Row As BOMRow,
    parent As TreeNodeCollection,
    cache As DrawingCache)

    Try

        If Row.ComponentDefinitions IsNot Nothing AndAlso
           Row.ComponentDefinitions.Count > 0 Then

            Dim defComp =
                Row.ComponentDefinitions.Item(1)

            If TypeOf defComp Is PartComponentDefinition Then

                If CType(
                    defComp,
                    PartComponentDefinition).IsContentMember Then

                    Return

                End If

            End If

            If defComp.BOMStructure <>
               BOMStructureEnum.kNormalBOMStructure Then

                Return

            End If

        End If

        Dim docPath As String = ""
        Dim partName As String = ""

        Try

            If Row.ComponentDefinitions IsNot Nothing AndAlso
               Row.ComponentDefinitions.Count > 0 Then

                Dim doc As Document =
                    Row.ComponentDefinitions.Item(1).Document

                docPath = doc.FullFileName

                Try

                    partName =
                        CStr(
                            doc.PropertySets.
                            Item("Design Tracking Properties").
                            Item("Part Number").Value)

                Catch

                    partName = ""

                End Try

            End If

        Catch
        End Try

        Dim itemNumber As String =
            Row.ItemNumber

        '-----------------------------------------------------
        ' CONSULTAR CACHE — SEM PERCORRER TODAS AS VISTAS
        '-----------------------------------------------------

        Dim pages As New List(Of String)
        Dim nomesFolhas As List(Of String) = Nothing

        If Not String.IsNullOrWhiteSpace(docPath) AndAlso
           cache IsNot Nothing AndAlso
           cache.MapaVistas.TryGetValue(docPath, nomesFolhas) Then

            For Each nomeFolha As String In nomesFolhas

                Dim pageNum As String

                If nomeFolha.Contains(":") Then

                    pageNum =
                        nomeFolha.Substring(
                            nomeFolha.LastIndexOf(":") + 1).
                        PadLeft(2, "0"c)

                Else

                    pageNum = "01"

                End If

                If Not pages.Contains(pageNum) Then
                    pages.Add(pageNum)
                End If

            Next

        End If

        pages.Sort()

        Dim inDrawing As Boolean =
            (pages.Count > 0)

        Dim status As String
        Dim pageText As String = ""

        If Not inDrawing Then

            status = "🚫"

        Else

            status =
                If(pages.Count = 1, "✔️", "🔵")

            pageText =
                "[Pág: " &
                FormatarPaginas(pages) &
                "]"

        End If

        Dim labelNumber As String =
            If(partName <> "", partName, itemNumber)

        Dim nodeText As String =
            String.Format(
                "({0}) {1} – {2} {3}",
                status,
                itemNumber,
                labelNumber,
                pageText)

        Dim tagData =
            Tuple.Create(
                docPath,
                itemNumber,
                labelNumber)

        Dim node As New TreeNode(nodeText) With {
            .Tag = tagData,
            .Name = itemNumber
        }

        parent.Add(node)

        If Row.ChildRows IsNot Nothing AndAlso
           Row.ChildRows.Count > 0 Then

            For Each childRow As BOMRow In Row.ChildRows

                AddBOMRowNode(
                    childRow,
                    node.Nodes,
                    cache)

            Next

        End If

    Catch
        ' Mantém a regra original de ignorar erros isolados de nós.
    End Try

End Sub

'################################################################
' ATUALIZAR LISTA DE FOLHAS USANDO CACHE
'################################################################

Sub AtualizarListaDeFolhas(
    sheetListView As ListView,
    drawingDoc As DrawingDocument,
    cache As DrawingCache)

    sheetListView.BeginUpdate()

    Try

        sheetListView.Items.Clear()

        If drawingDoc Is Nothing Then Return

        If cache Is Nothing Then
            cache = ConstruirCache(drawingDoc)
        End If

        For Each folha As Sheet In drawingDoc.Sheets

            Dim status As String = "🚫 Vazia"
            Dim qtdePersonalizada As String = "-"

            Dim folhaInfo As FolhaCache = Nothing

            If cache.Folhas.TryGetValue(folha.Name, folhaInfo) Then

                status = folhaInfo.Status
                qtdePersonalizada = folhaInfo.QtdePersonalizada

            End If

            Dim qtdeFormatada As String =
                qtdePersonalizada

            Dim valorInt As Integer

            If Integer.TryParse(
                qtdePersonalizada,
                valorInt) Then

                qtdeFormatada =
                    valorInt.ToString("D2")

            End If

            Dim item As New ListViewItem(folha.Name)

            item.SubItems.Add(status)
            item.SubItems.Add(qtdeFormatada)
            item.Checked = False

            sheetListView.Items.Add(item)

        Next

    Finally

        sheetListView.EndUpdate()

    End Try

End Sub

'################################################################
' ATUALIZAR FOLHAS + BOM + CACHE
'################################################################

Sub AtualizarFolhasEBOM(
    sheetListView As ListView,
    treeView As TreeView,
    drawingDoc As DrawingDocument,
    ByRef cache As DrawingCache)

    ' Reconstrói o cache uma única vez para o estado atual.

    cache = ConstruirCache(drawingDoc)

    AtualizarListaDeFolhas(
        sheetListView,
        drawingDoc,
        cache)

    Dim assemblyDoc As AssemblyDocument =
        GetAssemblyFromFirstSheet(drawingDoc)

    Dim bomRows As BOMRowsEnumerator =
        If(
            assemblyDoc IsNot Nothing,
            GetBOMRows(drawingDoc),
            Nothing)

    PreencherTreeView(
        treeView,
        bomRows,
        cache)

End Sub
'################################################################
' SHIFT NO TREEVIEW
'################################################################

Sub SelecionarIntervaloTreeView(
    TreeView As TreeView,
    primeiro As TreeNode,
    ultimo As TreeNode)

    If primeiro Is Nothing OrElse ultimo Is Nothing Then Return

    Dim todosNos As New List(Of TreeNode)

    For Each raiz As TreeNode In TreeView.Nodes
        AdicionarNosVisiveis(raiz, todosNos)
    Next

    Dim indiceInicial As Integer = todosNos.IndexOf(primeiro)
    Dim indiceFinal As Integer = todosNos.IndexOf(ultimo)

    If indiceInicial < 0 OrElse indiceFinal < 0 Then Return

    If indiceInicial > indiceFinal Then
        Dim temp As Integer = indiceInicial
        indiceInicial = indiceFinal
        indiceFinal = temp
    End If

    For i As Integer = indiceInicial To indiceFinal
        todosNos(i).Checked = True
    Next

End Sub

Sub AdicionarNosVisiveis(
    node As TreeNode,
    lista As List(Of TreeNode))

    lista.Add(node)

    If node.IsExpanded Then
        For Each filho As TreeNode In node.Nodes
            AdicionarNosVisiveis(filho, lista)
        Next
    End If

End Sub

'################################################################
' SHIFT NO LISTVIEW
'################################################################

Sub SelecionarIntervaloListView(
    ListView As ListView,
    primeiro As ListViewItem,
    ultimo As ListViewItem)

    If primeiro Is Nothing OrElse ultimo Is Nothing Then Return

    Dim indiceInicial As Integer = primeiro.Index
    Dim indiceFinal As Integer = ultimo.Index

    If indiceInicial > indiceFinal Then
        Dim temp As Integer = indiceInicial
        indiceInicial = indiceFinal
        indiceFinal = temp
    End If

    For i As Integer = indiceInicial To indiceFinal
        ListView.Items(i).Checked = True
    Next

End Sub

'################################################################
' EXTRAI NÚMERO DA PÁGINA
'################################################################

Function ExtrairNumeroPagina(nome As String) As String

    If nome.Contains(":") Then
        Return nome.Substring(
            nome.IndexOf(":") + 1).
            Trim().
            PadLeft(2, "0"c)
    End If

    Return nome

End Function

'################################################################
' COPIAR FOLHAS
'################################################################

Sub CopiarFolhasSelecionadas(
    sheetListView As ListView,
    drawingDoc As DrawingDocument)

    Dim selectedSheets =
        sheetListView.CheckedItems.
        Cast(Of ListViewItem)().
        Select(Function(i) i.Text).
        ToList()

    If selectedSheets.Count = 0 Then

        MessageBox.Show(
            "Selecione ao menos uma folha para copiar.",
            "Aviso",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)

        Return

    End If

    Dim BrowserPane As BrowserPane =
        GetBrowserPane(drawingDoc)

    If BrowserPane Is Nothing Then

        MessageBox.Show(
            "Não foi possível acessar o painel do navegador de folhas.",
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)

        Return

    End If

    Dim tempDrawingDoc As DrawingDocument = Nothing
    Dim oSheets As Sheets = drawingDoc.Sheets

    Dim mapOrigToCopy As New Dictionary(Of Sheet, Sheet)

    For Each nome In selectedSheets

        Try

            Dim shOrig As Sheet =
                oSheets.Item(nome)

            If tempDrawingDoc Is Nothing Then

                tempDrawingDoc =
                    CType(
                        ThisApplication.Documents.Add(
                            DocumentTypeEnum.kDrawingDocumentObject,
                            ,
                            False),
                        DrawingDocument)

            End If

            Dim tempSheet As Sheet = Nothing

            Try
                tempSheet = shOrig.CopyTo(tempDrawingDoc)
            Catch
                tempSheet = Nothing
            End Try

            Dim shCopia As Sheet = Nothing

            If tempSheet IsNot Nothing Then

                Try
                    shCopia = tempSheet.CopyTo(drawingDoc)
                Catch
                    shCopia = Nothing
                End Try

            End If

            If shCopia Is Nothing Then

                Try

                    Dim qtdAntes As Integer = oSheets.Count

                    shOrig.CopyTo(oSheets)

                    For j As Integer = qtdAntes + 1 To oSheets.Count

                        Dim tempSh As Sheet =
                            oSheets.Item(j)

                        If tempSh.Name <> shOrig.Name Then
                            shCopia = tempSh
                            Exit For
                        End If

                    Next

                    If shCopia Is Nothing Then

                        MessageBox.Show(
                            "Não foi possível localizar a cópia de: " & nome,
                            "Erro",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Error)

                        Continue For

                    End If

                Catch ex3 As Exception

                    MessageBox.Show(
                        "Erro ao copiar folha '" & nome & "': " & ex3.Message,
                        "Erro",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)

                    Continue For

                End Try

            End If

            mapOrigToCopy.Add(shOrig, shCopia)

        Catch ex As Exception

            MessageBox.Show(
                "Erro inesperado ao copiar '" & nome & "': " & ex.Message,
                "Erro",
                MessageBoxButtons.OK,
                MessageBoxIcon.Error)

        End Try

    Next

    If tempDrawingDoc IsNot Nothing Then
        Try
            tempDrawingDoc.Close(True)
        Catch
        End Try
    End If

    For Each kvp In mapOrigToCopy

        Try

            Dim nodeOrig =
                BrowserPane.GetBrowserNodeFromObject(kvp.Key)

            Dim nodeCopia =
                BrowserPane.GetBrowserNodeFromObject(kvp.Value)

            If nodeOrig IsNot Nothing AndAlso
               nodeCopia IsNot Nothing Then

                BrowserPane.Reorder(
                    nodeOrig,
                    False,
                    nodeCopia)

            End If

        Catch ex As Exception

            MessageBox.Show(
                "Erro ao reposicionar cópia de '" &
                kvp.Key.Name & "': " & ex.Message,
                "Aviso",
                MessageBoxButtons.OK,
                MessageBoxIcon.Warning)

        End Try

    Next

    drawingDoc.Update()

    MessageBox.Show(
        "Folhas copiadas com sucesso.",
        "Sucesso",
        MessageBoxButtons.OK,
        MessageBoxIcon.Information)

End Sub

