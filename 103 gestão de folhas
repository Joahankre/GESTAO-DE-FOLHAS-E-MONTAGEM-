'################################################################
' CHECKBOX
'################################################################

Function GetCheckedNodes(
    nodes As TreeNodeCollection) As List(Of TreeNode)


    Dim resultado As New List(Of TreeNode)


    For Each node As TreeNode In
        nodes


        If node.Checked Then

            resultado.Add(
                node)

        End If


        If node.Nodes.Count > 0 Then

            resultado.AddRange(
                GetCheckedNodes(
                    node.Nodes))

        End If

    Next


    Return resultado

End Function


Sub SetCheckState(
    nodes As TreeNodeCollection,
    state As Boolean)


    For Each node As TreeNode In
        nodes


        node.Checked =
            state


        If node.Nodes.Count > 0 Then

            SetCheckState(
                node.Nodes,
                state)

        End If

    Next

End Sub


'################################################################
' ORDENAÇÃO
'################################################################

Sub OrdenarTreeNodes(
    nodes As TreeNodeCollection)


    Dim lista As New List(Of TreeNode)


    For Each node As TreeNode In
        nodes

        lista.Add(
            node)

    Next


    lista.Sort(
        Function(a, b)

            Return CompararHierarquia(
                a.Name,
                b.Name)

        End Function)


    nodes.Clear()


    For Each node As TreeNode In
        lista


        nodes.Add(
            node)


        If node.Nodes.Count > 0 Then

            OrdenarTreeNodes(
                node.Nodes)

        End If

    Next

End Sub


Function CompararHierarquia(
    a As String,
    b As String) As Integer


    Dim partesA() As String =
        a.Split("."c)


    Dim partesB() As String =
        b.Split("."c)


    Dim tamanho As Integer =
        Math.Max(
            partesA.Length,
            partesB.Length)


    For i As Integer =
        0 To tamanho - 1


        Dim valorA As Integer = 0

        Dim valorB As Integer = 0


        If i < partesA.Length Then

            Integer.TryParse(
                partesA(i),
                valorA)

        End If


        If i < partesB.Length Then

            Integer.TryParse(
                partesB(i),
                valorB)

        End If


        Dim resultado =
            valorA.CompareTo(
                valorB)


        If resultado <> 0 Then

            Return resultado

        End If

    Next


    Return 0

End Function


'################################################################
' ASSEMBLY
'################################################################

Function GetAssemblyFromFirstSheet(
    drawingDoc As DrawingDocument) As AssemblyDocument


    Try

        If drawingDoc.Sheets.Count = 0 Then
            Return Nothing
        End If


        Dim sheet =
            drawingDoc.Sheets.Item(1)


        If sheet.DrawingViews.Count = 0 Then
            Return Nothing
        End If


        Dim view =
            sheet.DrawingViews.Item(1)


        Dim descriptor =
            view.ReferencedDocumentDescriptor


        If descriptor Is Nothing Then
            Return Nothing
        End If


        Dim doc =
            descriptor.ReferencedDocument


        If doc IsNot Nothing AndAlso
           doc.DocumentType =
           DocumentTypeEnum.kAssemblyDocumentObject Then


            Return CType(
                doc,
                AssemblyDocument)

        End If


    Catch

    End Try


    Return Nothing

End Function


'################################################################
' BOM
'################################################################

Function GetBOMRows(
    drawingDoc As DrawingDocument) As BOMRowsEnumerator


    Try

        If drawingDoc.Sheets.Count = 0 Then
            Return Nothing
        End If


        If drawingDoc.Sheets.Item(1).
           DrawingViews.Count = 0 Then

            Return Nothing

        End If


        Dim doc As Document =
            drawingDoc.
            Sheets.
            Item(1).
            DrawingViews.
            Item(1).
            ReferencedDocumentDescriptor.
            ReferencedDocument


        If Not TypeOf doc Is AssemblyDocument Then
            Return Nothing
        End If


        Dim assemblyDoc As AssemblyDocument =
            CType(
                doc,
                AssemblyDocument)


        Dim bom As BOM =
            assemblyDoc.
            ComponentDefinition.
            BOM


        bom.StructuredViewEnabled =
            True


        bom.StructuredViewFirstLevelOnly =
            False


        For Each view As BOMView In
            bom.BOMViews


            If view.ViewType =
               BOMViewTypeEnum.kStructuredBOMViewType Then


                Return view.BOMRows

            End If

        Next


    Catch ex As Exception


        MessageBox.Show(
            "Erro ao obter BOM:" &
            vbCrLf &
            ex.Message,
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)


    End Try


    Return Nothing

End Function


