'################################################################
' CACHE
'################################################################

Function ConstruirCache(
    drawingDoc As DrawingDocument) As DrawingCache


    Dim cache As New DrawingCache()


    For Each folha As Sheet In
        drawingDoc.Sheets


        Dim dados As New FolhaCache()


        dados.Nome =
            folha.Name


        For Each vista As DrawingView In
            folha.DrawingViews


            Try

                Dim doc As Document =
                    vista.
                    ReferencedDocumentDescriptor.
                    ReferencedDocument


                If doc Is Nothing Then Continue For


                Dim caminho As String =
                    doc.FullFileName


                If String.IsNullOrWhiteSpace(
                    caminho) Then Continue For


                '-----------------------------------------
                ' DOCUMENTO COM VISTA
                '-----------------------------------------

                cache.ArquivosComVistas.Add(
                    caminho)


                '-----------------------------------------
                ' FOLHA -> DOCUMENTO
                '-----------------------------------------

                dados.ArquivosReferenciados.Add(
                    caminho)


                '-----------------------------------------
                ' DOCUMENTO -> FOLHA
                '-----------------------------------------

                If Not cache.MapaVistas.ContainsKey(
                    caminho) Then

                    cache.MapaVistas(caminho) =
                        New List(Of String)

                End If


                If Not cache.MapaVistas(caminho).Contains(
                    folha.Name) Then

                    cache.MapaVistas(caminho).Add(
                        folha.Name)

                End If


                '-----------------------------------------
                ' QTDE PERSONALIZADA
                '-----------------------------------------

                If dados.QtdePersonalizada = "-" Then

                    Try

                        Dim props As PropertySet =
                            doc.PropertySets.Item(
                                "Inventor User Defined Properties")


                        Dim prop As Inventor.Property =
                            props.Item(
                                "QTDE PERSONALIZADA")


                        If prop IsNot Nothing AndAlso
                           prop.Value IsNot Nothing Then

                            dados.QtdePersonalizada =
                                prop.Value.ToString()

                        End If

                    Catch

                    End Try

                End If


            Catch

                'Vista inválida ou referência indisponível.

            End Try

        Next


        '---------------------------------------------
        ' CALCULAR STATUS DA FOLHA
        '---------------------------------------------

        If dados.ArquivosReferenciados.Count = 0 Then

            dados.Status =
                "🚫 Vazia"

        Else

            Dim paginas As New List(Of String)


            For Each arquivo In
                dados.ArquivosReferenciados


                Dim folhasDoArquivo As List(Of String) =
                    Nothing


                If cache.MapaVistas.TryGetValue(
                    arquivo,
                    folhasDoArquivo) Then

                    paginas.AddRange(
                        folhasDoArquivo)

                End If

            Next


            paginas =
                paginas.
                Distinct(
                    StringComparer.OrdinalIgnoreCase).
                OrderBy(
                    Function(x) x).
                ToList()


            If paginas.Count = 1 Then

                dados.Status =
                    "✔️ Pág: " &
                    ExtrairNumeroPagina(
                        paginas(0))

            Else

                Dim numeros =
                    paginas.
                    Select(
                        Function(x)
                            Return ExtrairNumeroPagina(x)
                        End Function).
                    ToList()


                dados.Status =
                    "🔁 Pág: " &
                    String.Join(
                        ", ",
                        numeros.ToArray())

            End If

        End If


        cache.Folhas(folha.Name) =
            dados


    Next


    Return cache

End Function


'################################################################
' TREEVIEW
'################################################################

Sub PreencherTreeView(
    treeView As TreeView,
    bomRows As BOMRowsEnumerator,
    cache As DrawingCache)


    treeView.BeginUpdate()


    Try

        treeView.Nodes.Clear()


        If bomRows Is Nothing Then Return


        For Each row As BOMRow In
            bomRows


            AddBOMRowNode(
                row,
                treeView.Nodes,
                cache)

        Next


        OrdenarTreeNodes(
            treeView.Nodes)


        'IMPORTANTE:
        '
        'Não usar ExpandAll aqui.
        '
        'O usuário pode expandir pelo botão.
        '
        'Isso reduz muito o custo inicial
        'em árvores grandes.

    Finally

        treeView.EndUpdate()

    End Try

End Sub


'################################################################
' ADICIONAR BOM
'################################################################

Sub AddBOMRowNode(
    row As BOMRow,
    parent As TreeNodeCollection,
    cache As DrawingCache)


    Try

        '-----------------------------------------------------
        ' FILTROS BOM
        '-----------------------------------------------------

        If row.ComponentDefinitions IsNot Nothing AndAlso
           row.ComponentDefinitions.Count > 0 Then


            Dim defComp =
                row.ComponentDefinitions.Item(1)


            If TypeOf defComp Is PartComponentDefinition Then

                If CType(
                    defComp,
                    PartComponentDefinition).
                    IsContentMember Then

                    Return

                End If

            End If


            If defComp.BOMStructure <>
               BOMStructureEnum.kNormalBOMStructure Then

                Return

            End If

        End If


        '-----------------------------------------------------
        ' DOCUMENTO
        '-----------------------------------------------------

        Dim docPath As String = ""

        Dim partName As String = ""


        Try

            If row.ComponentDefinitions IsNot Nothing AndAlso
               row.ComponentDefinitions.Count > 0 Then


                Dim doc As Document =
                    row.ComponentDefinitions.
                    Item(1).
                    Document


                If doc IsNot Nothing Then

                    docPath =
                        doc.FullFileName

                End If


                Try

                    partName =
                        doc.
                        PropertySets.
                        Item(
                            "Design Tracking Properties").
                        Item(
                            "Part Number").
                        Value.
                        ToString()

                Catch

                    partName = ""

                End Try

            End If


        Catch

        End Try


        '-----------------------------------------------------
        ' ITEM NUMBER
        '-----------------------------------------------------

        Dim itemNumber As String = ""


        Try

            itemNumber =
                row.ItemNumber

        Catch

        End Try


        '-----------------------------------------------------
        ' CONSULTAR CACHE
        '
        ' NÃO CONSULTA MAIS:
        '
        ' Sheet -> DrawingView -> ReferencedDocument
        '
        ' para cada BOMRow.
        '-----------------------------------------------------

        Dim paginas As New List(Of String)


        Dim inDrawing As Boolean =
            cache.MapaVistas.TryGetValue(
                docPath,
                paginas)


        Dim pageNumbers As New List(Of String)


        If inDrawing AndAlso
           paginas IsNot Nothing Then


            pageNumbers =
                paginas.
                Select(
                    Function(x)
                        Return ExtrairNumeroPagina(x)
                    End Function).
                Distinct().
                OrderBy(
                    Function(x)
                        Return ExtrairNumeroOrdenavel(x)
                    End Function).
                ToList()

        End If


        '-----------------------------------------------------
        ' STATUS
        '-----------------------------------------------------

        Dim status As String =
            If(
                inDrawing,
                "✔️",
                "🚫")


        Dim pageText As String = ""


        If pageNumbers.Count > 0 Then

            pageText =
                "[Pág: " &
                FormatarPaginas(
                    pageNumbers) &
                "]"

        End If


        '-----------------------------------------------------
        ' NOME
        '-----------------------------------------------------

        Dim label As String =
            If(
                String.IsNullOrWhiteSpace(partName),
                itemNumber,
                partName)


        Dim nodeText As String =
            String.Format(
                "({0}) {1} – {2} {3}",
                status,
                itemNumber,
                label,
                pageText)


        '-----------------------------------------------------
        ' TAG
        '-----------------------------------------------------

        Dim tagData =
            Tuple.Create(
                docPath,
                itemNumber,
                label)


        Dim node As New TreeNode(
            nodeText) With {

            .Name = itemNumber,
            .Tag = tagData
        }


        parent.Add(
            node)


        '-----------------------------------------------------
        ' FILHOS
        '-----------------------------------------------------

        If row.ChildRows IsNot Nothing AndAlso
           row.ChildRows.Count > 0 Then


            For Each child As BOMRow In
                row.ChildRows


                AddBOMRowNode(
                    child,
                    node.Nodes,
                    cache)

            Next

        End If


    Catch

        'Ignora um item inválido sem interromper a BOM.

    End Try

End Sub


'################################################################
' LISTVIEW
'################################################################

Sub AtualizarListaDeFolhas(
    listView As ListView,
    drawingDoc As DrawingDocument,
    cache As DrawingCache)


    listView.BeginUpdate()


    Try

        listView.Items.Clear()


        For Each folha As Sheet In
            drawingDoc.Sheets


            Dim dados As FolhaCache =
                Nothing


            If Not cache.Folhas.TryGetValue(
                folha.Name,
                dados) Then

                Continue For

            End If


            Dim item As New ListViewItem(
                dados.Nome)


            item.SubItems.Add(
                dados.Status)


            Dim qtde As String =
                dados.QtdePersonalizada


            If String.IsNullOrWhiteSpace(
                qtde) Then

                qtde = "-"

            End If


            Dim valor As Integer


            If Integer.TryParse(
                qtde,
                valor) Then

                qtde =
                    valor.ToString("D2")

            End If


            item.SubItems.Add(
                qtde)


            item.Checked =
                False


            listView.Items.Add(
                item)

        Next


    Finally

        listView.EndUpdate()

    End Try

End Sub


'################################################################
' PÁGINAS
'################################################################

Function ExtrairNumeroPagina(
    nome As String) As String


    If String.IsNullOrWhiteSpace(
        nome) Then

        Return ""

    End If


    If nome.Contains(":") Then

        Return nome.Substring(
            nome.LastIndexOf(":") + 1).
            Trim().
            PadLeft(
                2,
                "0"c)

    End If


    Return nome.Trim()

End Function


Function ExtrairNumeroOrdenavel(
    texto As String) As Double


    Dim regex As New System.Text.RegularExpressions.Regex(
        "\d+(\.\d+)?")


    Dim match =
        regex.Match(
            texto)


    If match.Success Then

        Dim valor As Double


        If Double.TryParse(
            match.Value,
            Globalization.NumberStyles.Any,
            Globalization.CultureInfo.InvariantCulture,
            valor) Then

            Return valor

        End If

    End If


    Return Double.MaxValue

End Function


Function FormatarPaginas(
    paginas As List(Of String)) As String


    If paginas Is Nothing OrElse
       paginas.Count = 0 Then

        Return ""

    End If


    Dim nums As New List(Of Integer)


    For Each p In paginas

        Dim n As Integer


        If Integer.TryParse(
            p,
            n) Then

            nums.Add(n)

        End If

    Next


    If nums.Count = 0 Then
        Return ""
    End If


    nums =
        nums.
        Distinct().
        OrderBy(
            Function(x) x).
        ToList()


    Dim resultado As New List(Of String)


    Dim inicio As Integer =
        nums(0)


    Dim anterior As Integer =
        nums(0)


    For i As Integer =
        1 To nums.Count - 1


        If nums(i) =
           anterior + 1 Then


            anterior =
                nums(i)


        Else


            If inicio = anterior Then

                resultado.Add(
                    inicio.ToString())

            Else

                resultado.Add(
                    inicio.ToString() &
                    "-" &
                    anterior.ToString())

            End If


            inicio =
                nums(i)


            anterior =
                nums(i)

        End If

    Next


    If inicio = anterior Then

        resultado.Add(
            inicio.ToString())

    Else

        resultado.Add(
            inicio.ToString() &
            "-" &
            anterior.ToString())

    End If


    Return String.Join(
        ", ",
        resultado)

End Function


'################################################################
' SHIFT TREEVIEW
'################################################################

Sub SelecionarIntervaloTreeView(
    treeView As TreeView,
    primeiro As TreeNode,
    ultimo As TreeNode)


    Dim lista As New List(Of TreeNode)


    For Each raiz As TreeNode In
        treeView.Nodes

        AdicionarNosVisiveis(
            raiz,
            lista)

    Next


    Dim inicio =
        lista.IndexOf(
            primeiro)


    Dim fim =
        lista.IndexOf(
            ultimo)


    If inicio < 0 OrElse
       fim < 0 Then

        Return

    End If


    If inicio > fim Then

        Dim temp =
            inicio

        inicio =
            fim

        fim =
            temp

    End If


    For i As Integer =
        inicio To fim

        lista(i).Checked =
            True

    Next

End Sub


Sub AdicionarNosVisiveis(
    node As TreeNode,
    lista As List(Of TreeNode))


    lista.Add(
        node)


    If node.IsExpanded Then

        For Each filho As TreeNode In
            node.Nodes

            AdicionarNosVisiveis(
                filho,
                lista)

        Next

    End If

End Sub


