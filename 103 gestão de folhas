Function GetCheckedNodes(
    nodes As TreeNodeCollection) As List(Of TreeNode)

    Dim result As New List(Of TreeNode)

    For Each n As TreeNode In nodes

        If n.Checked Then
            result.Add(n)
        End If

        If n.Nodes.Count > 0 Then
            result.AddRange(GetCheckedNodes(n.Nodes))
        End If

    Next

    Return result

End Function

