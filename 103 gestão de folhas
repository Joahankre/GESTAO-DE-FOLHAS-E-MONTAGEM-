Imports Inventor
Imports System.Drawing
Imports System.Linq
Imports System.Collections.Generic

'=========================================================
' CACHE DE UMA FOLHA
'=========================================================

Class FolhaCache

    Public Nome As String

    Public Status As String = "🚫 Vazia"

    Public QtdePersonalizada As String = "-"

    Public ArquivosReferenciados As New HashSet(Of String)(
        StringComparer.OrdinalIgnoreCase)

End Class


'=========================================================
' CACHE GERAL DO DESENHO
'=========================================================

Class DrawingCache

    'Caminho do documento
    '        ↓
    'Folhas onde ele possui vistas
    Public MapaVistas As New Dictionary(
        Of String,
        List(Of String))(
        StringComparer.OrdinalIgnoreCase)

    'Nome da folha
    '        ↓
    'informações da folha
    Public Folhas As New Dictionary(
        Of String,
        FolhaCache)(
        StringComparer.OrdinalIgnoreCase)

    'Documentos que já possuem vistas
    Public ArquivosComVistas As New HashSet(
        Of String)(
        StringComparer.OrdinalIgnoreCase)

End Class


