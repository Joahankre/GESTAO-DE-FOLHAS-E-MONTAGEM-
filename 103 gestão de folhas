                MessageBox.Show(
                    "Selecione ao menos um item na BOM.",
                    "Aviso",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

                Return

            End If


            Dim arquivosComVistas As New HashSet(
                Of String)(
                cache.ArquivosComVistas,
                StringComparer.OrdinalIgnoreCase)


            For Each node As TreeNode In
                nodesSelecionados

                Dim tag =
                    TryCast(
                        node.Tag,
                        Tuple(Of String, String, String))


                If tag Is Nothing Then Continue For


                If String.IsNullOrWhiteSpace(
                    tag.Item1) Then Continue For


                InsertBaseViewUsingCopiedSheet(
                    drawingDoc,
                    tag.Item1,
                    tag.Item2,
                    tag.Item3,
                    arquivosComVistas)


                arquivosComVistas.Add(
                    tag.Item1)

            Next


            'Depois de alterar o desenho,
            'o cache antigo deixa de ser válido.

            cache =
                ConstruirCache(
                    drawingDoc)


            AtualizarListaDeFolhas(
                sheetListView,
                drawingDoc,
                cache)

