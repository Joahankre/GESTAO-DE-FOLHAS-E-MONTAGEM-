' ============================================================
' EXCLUIR FOLHAS SELECIONADAS
' ============================================================

Sub ExcluirFolhasSelecionadas(
    sheetListView As ObjectListView,
    drawingDoc As DrawingDocument)

    Dim selectedSheets As List(Of String) =
        ObterFolhasSelecionadas(
            sheetListView)


    If selectedSheets.Count = 0 Then

        MessageBox.Show(
            "Selecione ao menos uma folha para excluir.",
            "Atenção",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)

        Return

    End If


    Dim nomes As String =
        String.Join(
            vbCrLf,
            selectedSheets.ToArray())


    Dim confirmResult =
        MessageBox.Show(
            "Folhas selecionadas:" &
            vbCrLf &
            vbCrLf &
            nomes &
            vbCrLf &
            vbCrLf &
            "Tem certeza que deseja excluir as folhas selecionadas?" &
            vbCrLf &
            "Essa ação não pode ser desfeita.",
            "Confirmar Exclusão",
            MessageBoxButtons.YesNo,
            MessageBoxIcon.Warning)


    If confirmResult <>
       DialogResult.Yes Then

        Return

    End If


    For i As Integer =
        drawingDoc.Sheets.Count To 1 Step -1

        Dim sh As Sheet =
            drawingDoc.Sheets.Item(i)


        If selectedSheets.Contains(
            sh.Name,
            StringComparer.OrdinalIgnoreCase) Then

            Try

                sh.Delete()

            Catch ex As Exception

                MessageBox.Show(
                    "Erro ao excluir folha '" &
                    sh.Name &
                    "': " &
                    ex.Message,
                    "Erro",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error)

            End Try

        End If

    Next


    drawingDoc.Update()


    MessageBox.Show(
        "Folhas excluídas com sucesso.",
        "Sucesso",
        MessageBoxButtons.OK,
        MessageBoxIcon.Information)

End Sub


' ============================================================
' INSERIR VISTA
' ============================================================

Sub InsertBaseViewUsingCopiedSheet(
    drawingDoc As DrawingDocument,
    partPath As String,
    itemNumber As String,
    labelNumber As String,
    arquivosComVistas As HashSet(Of String))

    If String.IsNullOrWhiteSpace(
        partPath) Then

        Return

    End If


    If arquivosComVistas IsNot Nothing AndAlso
       arquivosComVistas.Contains(
           partPath) Then

        Return

    End If


    Dim partDoc As Document =
        Nothing


    Try

        ' =====================================================
        ' ABRIR DOCUMENTO
        ' =====================================================

        Try

            partDoc =
                ThisApplication.Documents.Open(
                    partPath,
                    False)

        Catch ex As Exception

            MessageBox.Show(
                "Erro ao abrir arquivo:" &
                vbCrLf &
                partPath &
                vbCrLf &
                ex.Message,
                "Erro",
                MessageBoxButtons.OK,
                MessageBoxIcon.Error)

            Return

        End Try


        ' =====================================================
        ' NOVA FOLHA A3
        ' =====================================================

        Dim nomeFolha As String =
            SanitizarNomeFolha(
                itemNumber &
                " – " &
                labelNumber)


        Dim novaFolha As Sheet =
            drawingDoc.Sheets.Add(
                DrawingSheetSizeEnum.kA3DrawingSheetSize,
                PageOrientationTypeEnum.kLandscapePageOrientation,
                nomeFolha)


        novaFolha.Activate()


        ' =====================================================
        ' MARGEM
        ' =====================================================

        Dim nomeMargem As String =
            "FOLHA DOMA/LIGA"


        Dim margemDef As BorderDefinition =
            Nothing


        Try

            margemDef =
                drawingDoc.BorderDefinitions.Item(
                    nomeMargem)

        Catch

            margemDef =
                Nothing

        End Try


        If margemDef IsNot Nothing Then

            Try

                If novaFolha.Border IsNot Nothing Then

                    novaFolha.Border.Delete()

                End If


                novaFolha.AddBorder(
                    margemDef)

            Catch ex As Exception

                MessageBox.Show(
                    "Não foi possível adicionar a margem '" &
                    nomeMargem &
                    "'." &
                    vbCrLf &
                    ex.Message,
                    "Margem",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

            End Try

        End If


        ' =====================================================
        ' BLOCO DE TÍTULO
        ' =====================================================

        Dim nomeNovaLegenda As String =
            "SELO DOMA/LIGA"


        Dim oTitleBlockDef As TitleBlockDefinition =
            Nothing


        Try

            oTitleBlockDef =
                drawingDoc.TitleBlockDefinitions.Item(
                    nomeNovaLegenda)

        Catch

            oTitleBlockDef =
                Nothing

        End Try


        If oTitleBlockDef IsNot Nothing Then

            Try

                If novaFolha.TitleBlock IsNot Nothing Then

                    novaFolha.TitleBlock.Delete()

                End If


                novaFolha.AddTitleBlock(
                    oTitleBlockDef)

            Catch ex As Exception

                MessageBox.Show(
                    "Não foi possível adicionar a legenda '" &
                    nomeNovaLegenda &
                    "'." &
                    vbCrLf &
                    ex.Message,
                    "Bloco de Título",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

            End Try

        End If


        ' =====================================================
        ' ESCALA VISTA DOBRADA
        ' =====================================================

        Dim escalaDobrada As Double =
            1


        If TypeOf partDoc Is PartDocument Then

            escalaDobrada =
                CalcularEscalaIdeal(
                    CType(
                        partDoc,
                        PartDocument).ComponentDefinition)

        ElseIf TypeOf partDoc Is AssemblyDocument Then

            escalaDobrada =
                CalcularEscalaIdeal(
                    CType(
                        partDoc,
                        AssemblyDocument).ComponentDefinition)

        End If


        Dim tg As TransientGeometry =
            ThisApplication.TransientGeometry


        Dim posDobrada As Point2d =
            tg.CreatePoint2d(
                novaFolha.Width / 4,
                novaFolha.Height / 2)


        ' =====================================================
        ' VISTA DOBRADA
        ' =====================================================

        Dim vistaDobrada As DrawingView =
            novaFolha.DrawingViews.AddBaseView(
                partDoc,
                posDobrada,
                escalaDobrada,
                ViewOrientationTypeEnum.kDefaultViewOrientation,
                DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle)


        vistaDobrada.DisplayTangentEdges =
            True


        ' =====================================================
        ' VERIFICAR SHEET METAL
        ' =====================================================

        If Not TypeOf partDoc Is PartDocument Then

            partDoc.Close(False)

            partDoc =
                Nothing

            Return

        End If


        Dim smDef As SheetMetalComponentDefinition =
            Nothing


        Try

            Dim partDefinition As ComponentDefinition =
                CType(
                    partDoc,
                    PartDocument).ComponentDefinition


            If TypeOf partDefinition Is SheetMetalComponentDefinition Then

                smDef =
                    CType(
                        partDefinition,
                        SheetMetalComponentDefinition)

            Else

                partDoc.Close(False)

                partDoc =
                    Nothing

                Return

            End If


        Catch

            partDoc.Close(False)

            partDoc =
                Nothing

            Return

        End Try


        If smDef.Bends.Count = 0 Then

            partDoc.Close(False)

            partDoc =
                Nothing

            Return

        End If


        ' =====================================================
        ' FLAT PATTERN
        ' =====================================================

        Try

            If Not smDef.HasFlatPattern Then

                smDef.Unfold()

            End If

        Catch ex As Exception

            MessageBox.Show(
                "Não foi possível criar planificação:" &
                vbCrLf &
                ex.Message,
                "Sheet Metal",
                MessageBoxButtons.OK,
                MessageBoxIcon.Warning)


            partDoc.Close(False)

            partDoc =
                Nothing

            Return

        End Try


        ' =====================================================
        ' ANALISAR ORIENTAÇÃO
        ' =====================================================

        Dim flatPattern As FlatPattern =
            smDef.FlatPattern


        Dim qtdUp As Integer =
            0


        Dim qtdDown As Integer =
            0


        Try

            For Each bendResult As FlatBendResult In flatPattern.FlatBendResults

                If bendResult.IsOnBottomFace Then

                    Continue For

                End If


                If bendResult.IsDirectionUp Then

                    qtdUp += 1

                Else

                    qtdDown += 1

                End If

            Next

        Catch

        End Try


        If qtdDown > qtdUp Then

            Try

                Dim orientation As FlatPatternOrientation =
                    flatPattern.
                    FlatPatternOrientations.
                    ActiveFlatPatternOrientation


                orientation.FlipBaseFace =
                    Not orientation.FlipBaseFace


            Catch

                Try

                    Dim novaFace As Face =
                        FindOppositePlanarFace(
                            flatPattern)


                    If novaFace IsNot Nothing Then

                        smDef.Unfold2(
                            novaFace)


                        flatPattern =
                            smDef.FlatPattern

                    End If

                Catch

                End Try

            End Try

        End If


        Try

            CType(
                partDoc,
                PartDocument).Update()

        Catch

        End Try


        ' =====================================================
        ' ESCALA FLAT
        ' =====================================================

        Dim escalaFlat As Double =
            CalcularEscalaFlatPattern(
                smDef)


        Dim posFlat As Point2d =
            tg.CreatePoint2d(
                posDobrada.X,
                posDobrada.Y)


        Dim options As NameValueMap =
            ThisApplication.TransientObjects.
            CreateNameValueMap()


        options.Add(
            "SheetMetalFoldedModel",
            False)


        Dim vistaPlanificada As DrawingView =
            novaFolha.DrawingViews.AddBaseView(
                partDoc,
                posFlat,
                escalaFlat,
                ViewOrientationTypeEnum.kDefaultViewOrientation,
                DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle,
                "",
                Nothing,
                options)


        vistaPlanificada.DisplayTangentEdges =
            True


        drawingDoc.Update()


        ' =====================================================
        ' BEND NOTES
        ' =====================================================

        Dim tolerancia As Double =
            0.01


        Dim pontosProcessados As New List(Of Point2d)


        Dim bendCurves As New List(Of DrawingCurve)


        For Each curve As DrawingCurve In vistaPlanificada.DrawingCurves

            If curve.EdgeType =
               DrawingEdgeTypeEnum.kBendUpEdge OrElse
               curve.EdgeType =
               DrawingEdgeTypeEnum.kBendDownEdge Then

                bendCurves.Add(
                    curve)

            End If

        Next


        For Each curve As DrawingCurve In bendCurves

            Try

                Dim Mid As Point2d =
                    curve.MidPoint


                Dim duplicada As Boolean =
                    False


                For Each ponto As Point2d In pontosProcessados

                    Dim dx As Double =
                        Mid.X -
                        ponto.X


                    Dim dy As Double =
                        Mid.Y -
                        ponto.Y


                    Dim distancia As Double =
                        Math.Sqrt(
                            dx * dx +
                            dy * dy)


                    If distancia <=
                       tolerancia Then

                        duplicada =
                            True

                        Exit For

                    End If

                Next


                If duplicada Then
                    Continue For
                End If


                Dim bendNote As BendNote =
                    novaFolha.
                    DrawingNotes.
                    BendNotes.
                    Add(curve)


                bendNote.Position =
                    tg.CreatePoint2d(
                        Mid.X,
                        Mid.Y)


                pontosProcessados.Add(
                    tg.CreatePoint2d(
                        Mid.X,
                        Mid.Y))


            Catch

            End Try

        Next


        drawingDoc.Update()


        ' =====================================================
        ' FECHAR DOCUMENTO
        ' =====================================================

        Try

            partDoc.Close(False)

            partDoc =
                Nothing

        Catch

        End Try


    Catch ex As Exception

        MessageBox.Show(
            "Erro ao inserir vista:" &
            vbCrLf &
            ex.Message,
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)


        Try

            If partDoc IsNot Nothing Then

                partDoc.Close(False)

                partDoc =
                    Nothing

            End If

        Catch

        End Try

    End Try

End Sub


' ============================================================
' ESCALA VISTA DOBRADA
' ============================================================

Private Function CalcularEscalaIdeal(
    compDef As ComponentDefinition) As Double

    Try

        Dim oBox As Box =
            compDef.RangeBox


        Dim largura As Double =
            Math.Abs(
                oBox.MaxPoint.X -
                oBox.MinPoint.X)


        Dim altura As Double =
            Math.Abs(
                oBox.MaxPoint.Y -
                oBox.MinPoint.Y)


        Dim profundidade As Double =
            Math.Abs(
                oBox.MaxPoint.Z -
                oBox.MinPoint.Z)


        Dim tamanhoMaximo As Double =
            Math.Max(
                largura,
                Math.Max(
                    altura,
                    profundidade)) *
            10


        Dim areaUtil As Double =
            180


        If tamanhoMaximo <= 0 Then

            Return 1

        End If


        Dim escala As Double =
            areaUtil /
            tamanhoMaximo


        If escala >= 1 Then

            Return 1

        End If


        If escala >= 0.5 Then

            Return 0.5

        End If


        If escala >= 0.2 Then

            Return 0.2

        End If


        If escala >= 0.1 Then

            Return 0.1

        End If


        Return 0.05


    Catch

        Return 1

    End Try

End Function


' ============================================================
' FACE OPOSTA
' ============================================================

Private Function FindOppositePlanarFace(
    flatPattern As FlatPattern) As Face

    Try

        For Each bendResult As FlatBendResult
            In flatPattern.FlatBendResults

            If bendResult.IsOnBottomFace Then

                Try

                    For Each backFace As Face
                        In bendResult.Bend.BackFaces

                        For Each connectedFace As Face
                            In backFace.TangentiallyConnectedFaces

                            If connectedFace.SurfaceType =
                               SurfaceTypeEnum.kPlaneSurface Then

                                Return connectedFace

                            End If

                        Next

                    Next

                Catch

                End Try

            End If

        Next

    Catch

        Return Nothing

    End Try


    Return Nothing

End Function


' ============================================================
' ESCALA FLAT PATTERN
' ============================================================

Private Function CalcularEscalaFlatPattern(
    smDef As SheetMetalComponentDefinition) As Double

    Try

        If Not smDef.HasFlatPattern Then

            smDef.Unfold()

        End If


        Dim flatBox As Box =
            smDef.FlatPattern.RangeBox


        Dim largura As Double =
            Math.Abs(
                flatBox.MaxPoint.X -
                flatBox.MinPoint.X)


        Dim altura As Double =
            Math.Abs(
                flatBox.MaxPoint.Y -
                flatBox.MinPoint.Y)


        Dim tamanhoMaximo As Double =
            Math.Max(
                largura,
                altura) *
            10


        Dim areaUtil As Double =
            180


        If tamanhoMaximo <= 0 Then

            Return 0.1

        End If


        Dim escala As Double =
            areaUtil /
            tamanhoMaximo


        If escala >= 1 Then

            Return 1

        End If


        If escala >= 0.5 Then

            Return 0.5

        End If


        If escala >= 0.2 Then

            Return 0.2

        End If


        If escala >= 0.1 Then

            Return 0.1

        End If


        If escala >= 0.05 Then

            Return 0.05

        End If


        Return 0.02


    Catch

        Return 0.1

    End Try

End Function


' ============================================================
' SANITIZAR NOME DA FOLHA
' ============================================================

Function SanitizarNomeFolha(
    nomeOriginal As String) As String

    Dim caracteresInvalidos As Char() = {
        "<"c,
        ">"c,
        ":"c,
        """"c,
        "/"c,
        "\"c,
        "|"c,
        "?"c,
        "*"c,
        ","c
    }


    For Each c As Char
        In caracteresInvalidos

        nomeOriginal =
            nomeOriginal.Replace(
                c,
                "."c)

    Next


    Return nomeOriginal.Trim()

End Function


' ============================================================
' EXTRAIR NÚMERO ORDENÁVEL
' ============================================================

Function ExtrairNumeroOrdenavel(
    texto As String) As Double

    Dim regex As New System.Text.RegularExpressions.Regex(
        "\d+(\.\d+)?")


    Dim match =
        regex.Match(
            texto)


    If match.Success Then

        Dim valor As Double


        If Double.TryParse(
            match.Value,
            Globalization.NumberStyles.Any,
            Globalization.CultureInfo.InvariantCulture,
            valor) Then

            Return valor

        End If

    End If


    Return Double.MaxValue

End Function


' ============================================================
' MAPA DE VISTAS
' ============================================================

Function ObterMapaDeVistas(
    drawingDoc As DrawingDocument) As Dictionary(Of String, List(Of String))

    Dim mapa As New Dictionary(
        Of String,
        List(Of String))(
        StringComparer.OrdinalIgnoreCase)


    For Each folha As Sheet
        In drawingDoc.Sheets

        For Each vista As DrawingView
            In folha.DrawingViews

            Try

                Dim docRef =
                    vista.
                    ReferencedDocumentDescriptor.
                    ReferencedDocument


                If docRef IsNot Nothing Then

                    Dim caminho As String =
                        docRef.FullFileName


                    If Not mapa.ContainsKey(
                        caminho) Then

                        mapa(caminho) =
                            New List(Of String)

                    End If


                    If Not mapa(caminho).Contains(
                        folha.Name,
                        StringComparer.OrdinalIgnoreCase) Then

                        mapa(caminho).Add(
                            folha.Name)

                    End If

                End If


            Catch

            End Try

        Next

    Next


    Return mapa

End Function


' ============================================================
' ARQUIVOS COM VISTAS
' ============================================================

Function ObterArquivosComVistas(
    drawingDoc As DrawingDocument) As HashSet(Of String)

    Dim arquivos As New HashSet(
        Of String)(
        StringComparer.OrdinalIgnoreCase)


    For Each folha As Sheet
        In drawingDoc.Sheets

        For Each vista As DrawingView
            In folha.DrawingViews

            Dim docVista As Document =
                Nothing


            Try

                docVista =
                    vista.
                    ReferencedDocumentDescriptor.
                    ReferencedDocument

            Catch

                Continue For

            End Try


            If docVista IsNot Nothing Then

                Try

                    arquivos.Add(
                        docVista.FullFileName)

                Catch

                End Try

            End If

        Next

    Next


    Return arquivos

End Function
