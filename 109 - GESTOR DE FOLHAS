' ============================================================

Sub AdicionarObjetosRecursivos(
    obj As Object,
    lista As List(Of Object))

    If obj Is Nothing Then
        Return
    End If


    lista.Add(
        obj)


    Dim item As BOMItem =
        TryCast(
            obj,
            BOMItem)


    If item Is Nothing Then
        Return

    End If


    If item.Filhos Is Nothing Then
        Return

    End If


    For Each filho As BOMItem In item.Filhos

        AdicionarObjetosRecursivos(
            filho,
            lista)

    Next

End Sub


' ============================================================
' SELECIONAR INTERVALO - FOLHAS
' ============================================================

Sub SelecionarIntervaloFolhas(
    ListView As ObjectListView,
    indiceInicial As Integer,
    indiceFinal As Integer)

    If ListView Is Nothing Then
        Return
    End If

    If ListView.Items.Count = 0 Then
        Return
    End If


    If indiceInicial < 0 OrElse
       indiceInicial >= ListView.Items.Count Then

        Return

    End If


    If indiceFinal < 0 OrElse
       indiceFinal >= ListView.Items.Count Then

        Return

    End If


    If indiceInicial > indiceFinal Then

        Dim temp As Integer =
            indiceInicial

        indiceInicial =
            indiceFinal

        indiceFinal =
            temp

    End If


    ' ========================================================
    ' ADICIONAR O INTERVALO AOS CHECKS EXISTENTES
    ' ========================================================

    For i As Integer =
        indiceInicial To indiceFinal

        Dim item As OLVListItem =
            ListView.Items(i)

        If item IsNot Nothing Then

            item.Checked =
                True

        End If

    Next

End Sub



' ============================================================
' SELECIONAR INTERVALO - BOM
' ============================================================

Sub SelecionarIntervaloBOM(
    TreeView As TreeListView,
    indiceInicial As Integer,
    indiceFinal As Integer)

    If TreeView Is Nothing Then
        Return
    End If

    If TreeView.Items.Count = 0 Then
        Return
    End If


    If indiceInicial < 0 OrElse
       indiceInicial >= TreeView.Items.Count Then

        Return

    End If


    If indiceFinal < 0 OrElse
       indiceFinal >= TreeView.Items.Count Then

        Return

    End If


    If indiceInicial > indiceFinal Then

        Dim temp As Integer =
            indiceInicial

        indiceInicial =
            indiceFinal

        indiceFinal =
            temp

    End If


    Dim objetos As New List(Of Object)


    ' ========================================================
    ' PRESERVAR CHECKS EXISTENTES
    ' ========================================================

    For Each obj As Object In TreeView.CheckedObjects

        If obj IsNot Nothing Then

            If Not objetos.Contains(obj) Then

                objetos.Add(obj)

            End If

        End If

    Next


    ' ========================================================
    ' ADICIONAR INTERVALO
    ' ========================================================

    For i As Integer =
        indiceInicial To indiceFinal

        Dim item As OLVListItem =
            TreeView.Items(i)

        If item IsNot Nothing AndAlso
           item.RowObject IsNot Nothing Then

            If Not objetos.Contains(
                item.RowObject) Then

                objetos.Add(
                    item.RowObject)

            End If

        End If

    Next


    ' ========================================================
    ' APLICAR
    ' ========================================================

    TreeView.CheckedObjects =
        objetos

End Sub




' ============================================================
' CACHE
' ============================================================

Function ConstruirCache(
    drawingDoc As DrawingDocument) As DrawingCache

    Dim cache As New DrawingCache


    If drawingDoc Is Nothing Then
        Return cache
    End If


    ' ========================================================
    ' PRIMEIRA PASSAGEM
    ' ========================================================

    For Each folha As Sheet In drawingDoc.Sheets

        Dim folhaInfo As New FolhaCache


        folhaInfo.Nome =
            folha.Name


        Dim primeiroDocumentoComPropriedade As Boolean =
            False


        For Each vista As DrawingView In folha.DrawingViews

            Dim doc As Document =
                Nothing


            Try

                doc =
                    vista.
                    ReferencedDocumentDescriptor.
                    ReferencedDocument

            Catch

                Continue For

            End Try


            If doc Is Nothing Then
                Continue For

            End If


            Dim caminho As String =
                ""


            Try

                caminho =
                    doc.FullFileName

            Catch

                Continue For

            End Try


            If String.IsNullOrWhiteSpace(
                caminho) Then

                Continue For

            End If


            folhaInfo.ArquivosReferenciados.Add(
                caminho)


            cache.ArquivosComVistas.Add(
                caminho)


            Dim nomesFolhas As List(Of String) =
                Nothing


            If Not cache.MapaVistas.TryGetValue(
                caminho,
                nomesFolhas) Then

                nomesFolhas =
                    New List(Of String)


                cache.MapaVistas.Add(
                    caminho,
                    nomesFolhas)

            End If


            If Not nomesFolhas.Contains(
                folha.Name,
                StringComparer.OrdinalIgnoreCase) Then

                nomesFolhas.Add(
                    folha.Name)

            End If


            ' =================================================
            ' QTDE PERSONALIZADA
            ' =================================================

            If Not primeiroDocumentoComPropriedade Then

                Try

                    Dim props As PropertySet =
                        doc.PropertySets.Item(
                            "Inventor User Defined Properties")


                    Try

                        Dim prop As Inventor.Property =
                            props.Item(
                                "QTDE PERSONALIZADA")


                        If prop IsNot Nothing AndAlso
                           prop.Value IsNot Nothing Then

                            folhaInfo.QtdePersonalizada =
                                prop.Value.ToString()

                        End If

                    Catch

                    End Try


                    primeiroDocumentoComPropriedade =
                        True

                Catch

                End Try

            End If

        Next


        cache.Folhas(
            folha.Name) =
            folhaInfo

    Next


    ' ========================================================
    ' SEGUNDA PASSAGEM
    ' ========================================================

    For Each folha As Sheet In drawingDoc.Sheets

        Dim folhaInfo As FolhaCache =
            Nothing


        If Not cache.Folhas.TryGetValue(
            folha.Name,
            folhaInfo) Then

            Continue For

        End If


        If folhaInfo.ArquivosReferenciados.Count = 0 Then

            folhaInfo.Status =
                "🚫 Vazia"


            Continue For

        End If


        Dim todasPaginas As New List(Of String)


        For Each arquivo As String In folhaInfo.ArquivosReferenciados

            Dim nomesFolhas As List(Of String) =
                Nothing


            If cache.MapaVistas.TryGetValue(
                arquivo,
                nomesFolhas) Then

                todasPaginas.AddRange(
                    nomesFolhas)

            End If

        Next


        Dim paginasNumericas As New List(Of Integer)


        For Each nomeFolha As String In todasPaginas

            Dim numero As Integer


            If Integer.TryParse(
                ExtrairNumeroPagina(nomeFolha),
                numero) Then

                If Not paginasNumericas.Contains(
                    numero) Then

                    paginasNumericas.Add(
                        numero)

                End If

            End If

        Next


        paginasNumericas.Sort()


        If paginasNumericas.Count = 0 Then

            folhaInfo.Status =
                "🚫"

        Else

            Dim paginasFormatadas As New List(Of String)


            For Each numero As Integer In paginasNumericas

                paginasFormatadas.Add(
                    numero.ToString())

            Next


            Dim textoPaginas As String =
                String.Join(
                    ". ",
                    paginasFormatadas.ToArray())


            If paginasNumericas.Count = 1 Then

                folhaInfo.Status =
                    "✔️ Pág: " &
                    textoPaginas

            Else

                folhaInfo.Status =
                    "🔁 Pág: " &
                    textoPaginas

            End If

        End If

    Next


    Return cache

End Function


' ============================================================
' ASSEMBLY
' ============================================================

Function GetAssemblyFromFirstSheet(
    drawingDoc As DrawingDocument) As AssemblyDocument

    Try

        If drawingDoc.Sheets.Count = 0 Then
            Return Nothing
        End If


        Dim firstSheet As Sheet =
            drawingDoc.Sheets.Item(1)


        If firstSheet.DrawingViews.Count = 0 Then
            Return Nothing
        End If


        Dim baseDrawingView As DrawingView =
            firstSheet.DrawingViews.Item(1)


        Dim refDocDescriptor =
            baseDrawingView.
            ReferencedDocumentDescriptor


        If refDocDescriptor Is Nothing Then
            Return Nothing
        End If


        Dim refDoc =
            refDocDescriptor.ReferencedDocument


        If refDoc IsNot Nothing AndAlso
           refDoc.DocumentType =
           DocumentTypeEnum.kAssemblyDocumentObject Then

            Return CType(
                refDoc,
                AssemblyDocument)

        End If

    Catch

    End Try


    Return Nothing

End Function


' ============================================================
' BOM
' ============================================================

Function GetBOMRows(
    drawingDoc As DrawingDocument) As BOMRowsEnumerator

    Try

        If drawingDoc.Sheets.Count = 0 OrElse
           drawingDoc.Sheets.Item(1).
           DrawingViews.Count = 0 Then

            Return Nothing

        End If


        Dim refDoc As Document =
            drawingDoc.
            Sheets.Item(1).
            DrawingViews.Item(1).
            ReferencedDocumentDescriptor.
            ReferencedDocument


        If Not TypeOf refDoc Is AssemblyDocument Then
            Return Nothing

        End If


        Dim asm As AssemblyDocument =
            CType(
                refDoc,
                AssemblyDocument)


        Dim bom As BOM =
            asm.ComponentDefinition.BOM


        bom.StructuredViewEnabled =
            True


        bom.StructuredViewFirstLevelOnly =
            False


        For Each bomView As BOMView In bom.BOMViews

            If BOMView.ViewType =
               BOMViewTypeEnum.kStructuredBOMViewType Then

                Return BOMView.BOMRows

            End If

        Next

    Catch

    End Try


    Return Nothing

End Function


' ============================================================
' EXTRAI NÚMERO DA PÁGINA
' ============================================================

Function ExtrairNumeroPagina(
    nome As String) As String

    If nome.Contains(":") Then

        Return nome.Substring(
            nome.IndexOf(":") + 1).
            Trim().
            PadLeft(
                2,
                "0"c)

    End If


    Return nome

End Function


' ============================================================
' FORMATAR PÁGINAS
' ============================================================

Function FormatarPaginas(
    paginas As List(Of String)) As String

    If paginas Is Nothing OrElse
       paginas.Count = 0 Then

        Return ""

    End If


    Dim nums As New List(Of Integer)


    For Each p As String In paginas

        Dim n As Integer


        If Integer.TryParse(
            p,
            n) Then

            nums.Add(
                n)

        End If

    Next


    If nums.Count = 0 Then
        Return ""

    End If


    nums =
        nums.
        Distinct().
        OrderBy(
            Function(n) n).
        ToList()


    Dim resultado As New List(Of String)


    For Each n As Integer In nums

        resultado.Add(
            n.ToString())

    Next


    Return String.Join(
        ". ",
        resultado)

End Function


' ============================================================
' COMPARAR HIERARQUIA
' ============================================================

Function CompararHierarquia(
    a As String,
    b As String) As Integer

    Dim partesA() As String =
        a.Split("."c)


    Dim partesB() As String =
        b.Split("."c)


    Dim maxLength As Integer =
        Math.Max(
            partesA.Length,
            partesB.Length)


    For i As Integer =
        0 To maxLength - 1

        Dim valorA As Integer =
            0


        Dim valorB As Integer =
            0


        If i < partesA.Length Then

            Integer.TryParse(
                partesA(i),
                valorA)

        End If


        If i < partesB.Length Then

            Integer.TryParse(
                partesB(i),
                valorB)

        End If


        Dim resultado As Integer =
            valorA.CompareTo(
                valorB)


        If resultado <> 0 Then

            Return resultado

        End If

    Next


    Return 0

End Function


' ============================================================
' COPIAR FOLHAS SELECIONADAS
' ============================================================

Sub CopiarFolhasSelecionadas(
    sheetListView As ObjectListView,
    drawingDoc As DrawingDocument)

    Dim selectedSheets As List(Of String) =
        ObterFolhasSelecionadas(
            sheetListView)


    If selectedSheets.Count = 0 Then

        MessageBox.Show(
            "Selecione ao menos uma folha para copiar.",
            "Aviso",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)

        Return

    End If


    Dim browserPane As BrowserPane =
        GetBrowserPane(
            drawingDoc)


    If browserPane Is Nothing Then

        MessageBox.Show(
            "Não foi possível acessar o painel do navegador de folhas.",
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)

        Return

    End If


    Dim tempDrawingDoc As DrawingDocument =
        Nothing


    Dim oSheets As Sheets =
        drawingDoc.Sheets


    Dim mapOrigToCopy As New Dictionary(
        Of Sheet,
        Sheet)


    For Each nome As String In selectedSheets

        Try

            Dim shOrig As Sheet =
                oSheets.Item(nome)


            If tempDrawingDoc Is Nothing Then

                tempDrawingDoc =
                    CType(
                        ThisApplication.Documents.Add(
                            DocumentTypeEnum.kDrawingDocumentObject,
                            ,
                            False),
                        DrawingDocument)

            End If


            Dim tempSheet As Sheet =
                Nothing


            Try

                tempSheet =
                    shOrig.CopyTo(
                        tempDrawingDoc)

            Catch

                tempSheet =
                    Nothing

            End Try


            Dim shCopia As Sheet =
                Nothing


            If tempSheet IsNot Nothing Then

                Try

                    shCopia =
                        tempSheet.CopyTo(
                            drawingDoc)

                Catch

                    shCopia =
                        Nothing

                End Try

            End If


            If shCopia Is Nothing Then

                Try

                    Dim qtdAntes As Integer =
                        oSheets.Count


                    shOrig.CopyTo(
                        oSheets)


                    For j As Integer =
                        qtdAntes + 1 To oSheets.Count

                        Dim tempSh As Sheet =
                            oSheets.Item(j)


                        If tempSh.Name <>
                           shOrig.Name Then

                            shCopia =
                                tempSh

                            Exit For

                        End If

                    Next


                    If shCopia Is Nothing Then

                        MessageBox.Show(
                            "Não foi possível localizar a cópia de: " &
                            nome,
                            "Erro",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Error)

                        Continue For

                    End If

                Catch ex3 As Exception

                    MessageBox.Show(
                        "Erro ao copiar folha '" &
                        nome &
                        "': " &
                        ex3.Message,
                        "Erro",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)

                    Continue For

                End Try

            End If


            mapOrigToCopy.Add(
                shOrig,
                shCopia)


        Catch ex As Exception

            MessageBox.Show(
                "Erro inesperado ao copiar '" &
                nome &
                "': " &
                ex.Message,
                "Erro",
                MessageBoxButtons.OK,
                MessageBoxIcon.Error)

        End Try

    Next


    If tempDrawingDoc IsNot Nothing Then

        Try

            tempDrawingDoc.Close(
                True)

        Catch

        End Try

    End If


    For Each kvp In mapOrigToCopy

        Try

            Dim nodeOrig =
                browserPane.GetBrowserNodeFromObject(
                    kvp.Key)


            Dim nodeCopia =
                browserPane.GetBrowserNodeFromObject(
                    kvp.Value)


            If nodeOrig IsNot Nothing AndAlso
               nodeCopia IsNot Nothing Then

                browserPane.Reorder(
                    nodeOrig,
                    False,
                    nodeCopia)

            End If


        Catch ex As Exception

            MessageBox.Show(
                "Erro ao reposicionar cópia de '" &
                kvp.Key.Name &
                "': " &
                ex.Message,
                "Aviso",
                MessageBoxButtons.OK,
                MessageBoxIcon.Warning)

        End Try

    Next


    drawingDoc.Update()


    MessageBox.Show(
        "Folhas copiadas com sucesso.",
        "Sucesso",
        MessageBoxButtons.OK,
        MessageBoxIcon.Information)

End Sub


