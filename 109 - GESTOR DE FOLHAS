' ============================================================
' PREENCHE TREELISTVIEW
' ============================================================

Sub PreencherTreeListView(
    treeView As TreeListView,
    bomRows As BOMRowsEnumerator,
    cache As DrawingCache)

    treeView.BeginUpdate()

    Try

        treeView.Roots =
            Nothing


        If bomRows Is Nothing Then
            Return
        End If


        Dim roots As New List(Of BOMItem)


        For Each row As BOMRow
            In bomRows

            Dim item As BOMItem =
                CriarBOMItem(
                    Row,
                    cache,
                    0)


            If item IsNot Nothing Then

                roots.Add(
                    item)

            End If

        Next


        roots.Sort(
            Function(a, b)

                Return CompararHierarquia(
                    a.ItemNumber,
                    b.ItemNumber)

            End Function)


        treeView.Roots =
            roots


        treeView.ExpandAll()

    Finally

        treeView.EndUpdate()

    End Try

End Sub


' ============================================================
' CRIAR ITEM BOM
' ============================================================

Function CriarBOMItem(
    row As BOMRow,
    cache As DrawingCache,
    nivel As Integer) As BOMItem

    Try

        If row.ComponentDefinitions IsNot Nothing AndAlso
           row.ComponentDefinitions.Count > 0 Then

            Dim defComp =
                row.ComponentDefinitions.Item(1)


            If TypeOf defComp Is PartComponentDefinition Then

                If CType(
                    defComp,
                    PartComponentDefinition).IsContentMember Then

                    Return Nothing

                End If

            End If


            If defComp.BOMStructure <>
               BOMStructureEnum.kNormalBOMStructure Then

                Return Nothing

            End If

        End If


        Dim docPath As String =
            ""


        Dim partName As String =
            ""


        Try

            If row.ComponentDefinitions IsNot Nothing AndAlso
               row.ComponentDefinitions.Count > 0 Then

                Dim doc As Document =
                    row.ComponentDefinitions.Item(1).Document


                docPath =
                    doc.FullFileName


                Try

                    partName =
                        CStr(
                            doc.PropertySets.
                            Item(
                                "Design Tracking Properties").
                            Item(
                                "Part Number").Value)

                Catch

                    partName =
                        ""

                End Try

            End If

        Catch

        End Try


        Dim itemNumber As String =
            row.ItemNumber


        Dim pages As New List(Of String)


        Dim nomesFolhas As List(Of String) =
            Nothing


        If Not String.IsNullOrWhiteSpace(
            docPath) AndAlso
           cache IsNot Nothing AndAlso
           cache.MapaVistas.TryGetValue(
               docPath,
               nomesFolhas) Then

            For Each nomeFolha As String In nomesFolhas

                Dim pageNum As String


                If nomeFolha.Contains(":") Then

                    pageNum =
                        nomeFolha.Substring(
                            nomeFolha.LastIndexOf(":") + 1).
                        PadLeft(
                            2,
                            "0"c)

                Else

                    pageNum =
                        "01"

                End If


                If Not pages.Contains(
                    pageNum) Then

                    pages.Add(
                        pageNum)

                End If

            Next

        End If


        pages.Sort()


        Dim status As String


        Dim pageText As String =
            ""


        If pages.Count = 0 Then

            status =
                "🚫"

        ElseIf pages.Count = 1 Then

            status =
                "✔️"


            pageText =
                FormatarPaginas(
                    pages)

        Else

            status =
                "🔵"


            pageText =
                FormatarPaginas(
                    pages)

        End If


        Dim labelNumber As String =
            If(
                partName <> "",
                partName,
                itemNumber)


        Dim label As String


        If pageText <> "" Then

            label =
                "(" &
                status &
                ") " &
                itemNumber &
                " – " &
                labelNumber &
                " [Pág: " &
                pageText &
                "]"

        Else

            label =
                "(" &
                status &
                ") " &
                itemNumber &
                " – " &
                labelNumber

        End If


        Dim item As New BOMItem()


        item.ItemNumber =
            itemNumber


        item.PartNumber =
            partName


        item.Status =
            status


        item.Paginas =
            pageText


        item.DocPath =
            docPath


        item.Label =
            label


        item.Nivel =
            nivel


        If row.ChildRows IsNot Nothing AndAlso
           row.ChildRows.Count > 0 Then

            For Each childRow As BOMRow In row.ChildRows

                Dim filho As BOMItem =
                    CriarBOMItem(
                        childRow,
                        cache,
                        nivel + 1)


                If filho IsNot Nothing Then

                    item.Filhos.Add(
                        filho)

                End If

            Next

        End If


        item.Filhos.Sort(
            Function(a, b)

                Return CompararHierarquia(
                    a.ItemNumber,
                    b.ItemNumber)

            End Function)


        Return item

    Catch

        Return Nothing

    End Try

End Function


' ============================================================
' ATUALIZAR OBJECTLISTVIEW
' ============================================================

Sub AtualizarObjectListView(
    listView As ObjectListView,
    drawingDoc As DrawingDocument,
    cache As DrawingCache)

    listView.BeginUpdate()

    Try

        listView.ClearObjects()


        If drawingDoc Is Nothing Then
            Return
        End If


        If cache Is Nothing Then

            cache =
                ConstruirCache(
                    drawingDoc)

        End If


        Dim objetos As New List(Of FolhaItem)


        For Each folha As Sheet In drawingDoc.Sheets

            Dim status As String =
                "🚫 Vazia"


            Dim qtde As String =
                "-"


            Dim folhaInfo As FolhaCache =
                Nothing


            If cache.Folhas.TryGetValue(
                folha.Name,
                folhaInfo) Then

                status =
                    folhaInfo.Status


                qtde =
                    folhaInfo.QtdePersonalizada

            End If


            Dim qtdeFormatada As String =
                qtde


            Dim valorInt As Integer


            If Integer.TryParse(
                qtde,
                valorInt) Then

                qtdeFormatada =
                    valorInt.ToString(
                        "D2")

            End If


            objetos.Add(
                New FolhaItem With {
                    .Folha =
                        folha.Name,
                    .Conferencia =
                        status,
                    .QtdePersonalizada =
                        qtdeFormatada})

        Next


        listView.SetObjects(
            objetos)

    Finally

        listView.EndUpdate()

    End Try

End Sub


' ============================================================
' ATUALIZAR FOLHAS + BOM
' ============================================================

Sub AtualizarFolhasEBOM(
    sheetListView As ObjectListView,
    treeView As TreeListView,
    drawingDoc As DrawingDocument,
    ByRef cache As DrawingCache)

    cache =
        ConstruirCache(
            drawingDoc)


    AtualizarObjectListView(
        sheetListView,
        drawingDoc,
        cache)


    Dim assemblyDoc As AssemblyDocument =
        GetAssemblyFromFirstSheet(
            drawingDoc)


    Dim bomRows As BOMRowsEnumerator =
        Nothing


    If assemblyDoc IsNot Nothing Then

        bomRows =
            GetBOMRows(
                drawingDoc)

    End If


    PreencherTreeListView(
        treeView,
        bomRows,
        cache)

End Sub


