    ' ========================================================

    AddHandler btnSelectByPrefix.Click,
        Sub()

            Dim prefixo As String =
                InputBox(
                    "Digite o prefixo:",
                    "Selecionar por Prefixo")


            If String.IsNullOrWhiteSpace(
                prefixo) Then

                Return

            End If


            If prefixo.Length < 2 Then

                MessageBox.Show(
                    "Digite ao menos 2 caracteres.",
                    "Prefixo inválido",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

                Return

            End If


            For Each item As OLVListItem In sheetListView.Items

                Dim folha As FolhaItem =
                    TryCast(
                        item.RowObject,
                        FolhaItem)


                If folha Is Nothing Then
                    Continue For
                End If


                If folha.Folha.StartsWith(
                    prefixo,
                    StringComparison.OrdinalIgnoreCase) Then

                    item.Checked =
                        True

                End If

            Next

        End Sub


