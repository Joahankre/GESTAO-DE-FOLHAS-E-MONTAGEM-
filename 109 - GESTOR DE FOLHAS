' SELEÇÃO SHIFT / CTRL - FOLHAS
' ============================================================

Dim ultimoIndiceFolha As Integer = -1
Dim ultimaSelecaoFolha As OLVListItem = Nothing


AddHandler sheetListView.MouseDown,
    Sub(sender As Object, E As MouseEventArgs)

        If E.Button <> MouseButtons.Left Then
            Return
        End If

        Dim itemAtual As OLVListItem =
            sheetListView.GetItemAt(E.X, E.Y)

        If itemAtual Is Nothing Then
            Return
        End If

        Dim indiceAtual As Integer =
            itemAtual.Index

        Dim shiftPressed As Boolean =
            (Control.ModifierKeys And Keys.Shift) = Keys.Shift

        Dim ctrlPressed As Boolean =
            (Control.ModifierKeys And Keys.Control) = Keys.Control


        ' ====================================================
        ' SHIFT
        ' Seleciona intervalo entre último item e item atual
        ' ====================================================

        If shiftPressed AndAlso
           ultimoIndiceFolha >= 0 Then

            SelecionarIntervaloFolhas(
                sheetListView,
                ultimoIndiceFolha,
                indiceAtual)

            Return

        End If


        ' ====================================================
        ' CTRL
        ' O comportamento padrão do ListView é mantido.
        ' Apenas atualizamos a âncora da seleção.
        ' ====================================================

        If ctrlPressed Then

            ultimoIndiceFolha =
                indiceAtual

            ultimaSelecaoFolha =
                itemAtual

            Return

        End If


        ' ====================================================
        ' CLIQUE NORMAL
        ' Define nova âncora
        ' ====================================================

        ultimoIndiceFolha =
            indiceAtual

        ultimaSelecaoFolha =
            itemAtual

    End Sub



' ============================================================
' SELEÇÃO SHIFT - BOM
' ============================================================

Dim ultimoIndiceBOM As Integer = -1
Dim ultimaSelecaoBOM As OLVListItem = Nothing


AddHandler treeView.MouseDown,
    Sub(sender As Object, E As MouseEventArgs)

        If E.Button <> MouseButtons.Left Then
            Return
        End If

        Dim itemAtual As OLVListItem =
            treeView.GetItemAt(E.X, E.Y)

        If itemAtual Is Nothing Then
            Return
        End If

        Dim indiceAtual As Integer =
            itemAtual.Index

        Dim shiftPressed As Boolean =
            (Control.ModifierKeys And Keys.Shift) = Keys.Shift

        Dim ctrlPressed As Boolean =
            (Control.ModifierKeys And Keys.Control) = Keys.Control


        If shiftPressed AndAlso
           ultimoIndiceBOM >= 0 Then

            SelecionarIntervaloBOM(
                treeView,
                ultimoIndiceBOM,
                indiceAtual)

            Return

        End If


        If ctrlPressed Then

            ultimoIndiceBOM =
                indiceAtual

            ultimaSelecaoBOM =
                itemAtual

            Return

        End If


        ultimoIndiceBOM =
            indiceAtual

        ultimaSelecaoBOM =
            itemAtual

    End Sub


    ' ========================================================
