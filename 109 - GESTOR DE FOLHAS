    AddHandler btnInsert.Click,
        Sub()

            Dim selecionados As List(Of BOMItem) =
                ObterBOMSelecionados(
                    treeView)


            If selecionados.Count = 0 Then

                MessageBox.Show(
                    "Selecione ao menos um item na BOM.",
                    "Aviso",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning)

                Return

            End If


            Dim arquivosComVistas As New HashSet(Of String)(
                cache.ArquivosComVistas,
                StringComparer.OrdinalIgnoreCase)


            For Each item As BOMItem
                In selecionados

                If item Is Nothing Then
                    Continue For
                End If


                If String.IsNullOrWhiteSpace(
                    item.DocPath) Then

                    Continue For

                End If


                InsertBaseViewUsingCopiedSheet(
                    drawingDoc,
                    item.DocPath,
                    item.ItemNumber,
                    item.PartNumber,
                    arquivosComVistas)


                arquivosComVistas.Add(
                    item.DocPath)

            Next


            AtualizarFolhasEBOM(
                sheetListView,
                treeView,
                drawingDoc,
                cache)

        End Sub


