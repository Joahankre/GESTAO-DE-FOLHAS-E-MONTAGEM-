'################################################################
' TREEVIEW
'################################################################

Sub PreencherTreeView(
treeView As TreeView,
drawingDoc As DrawingDocument,
bomRows As BOMRowsEnumerator)

treeView.Nodes.Clear()

If bomRows Is Nothing Then Return

Dim mapaVistas =
    ObterMapaDeVistas(drawingDoc)

For Each row As BOMRow In bomRows

    AddBOMRowNode(
        Row,
        treeView.Nodes,
        drawingDoc,
        mapaVistas)

Next

OrdenarTreeNodes(treeView.Nodes)

treeView.ExpandAll()

End Sub

'################################################################
' SHIFT NO TREEVIEW
'################################################################

Sub SelecionarIntervaloTreeView(
treeView As TreeView,
primeiro As TreeNode,
ultimo As TreeNode)

If primeiro Is Nothing OrElse ultimo Is Nothing Then Return

Dim todosNos As New List(Of TreeNode)

For Each raiz As TreeNode In treeView.Nodes

    AdicionarNosVisiveis(
        raiz,
        todosNos)

Next

Dim indiceInicial As Integer =
    todosNos.IndexOf(primeiro)

Dim indiceFinal As Integer =
    todosNos.IndexOf(ultimo)

If indiceInicial < 0 OrElse indiceFinal < 0 Then
    Return
End If

If indiceInicial > indiceFinal Then

    Dim temp As Integer =
        indiceInicial

    indiceInicial =
        indiceFinal

    indiceFinal =
        temp

End If

For i As Integer =
    indiceInicial To indiceFinal

    todosNos(i).Checked = True

Next

End Sub

Sub AdicionarNosVisiveis(
node As TreeNode,
lista As List(Of TreeNode))

lista.Add(node)

If node.IsExpanded Then

    For Each filho As TreeNode In node.Nodes

        AdicionarNosVisiveis(
            filho,
            lista)

    Next

End If

End Sub

'################################################################
' SHIFT NO LISTVIEW
'################################################################

Sub SelecionarIntervaloListView(
listView As ListView,
primeiro As ListViewItem,
ultimo As ListViewItem)

If primeiro Is Nothing OrElse ultimo Is Nothing Then Return

Dim indiceInicial As Integer =
    primeiro.Index

Dim indiceFinal As Integer =
    ultimo.Index

If indiceInicial > indiceFinal Then

    Dim temp As Integer =
        indiceInicial

    indiceInicial =
        indiceFinal

    indiceFinal =
        temp

End If

For i As Integer =
    indiceInicial To indiceFinal

    listView.Items(i).Checked = True

Next

End Sub

'################################################################
' LISTA DE FOLHAS
'################################################################

Sub AtualizarListaDeFolhas(
sheetListView As ListView,
drawingDoc As DrawingDocument)

sheetListView.Items.Clear()

Dim mapaDeReferencias As New Dictionary(
    Of String,
    List(Of String))(
    StringComparer.OrdinalIgnoreCase)

For Each folha As Sheet In drawingDoc.Sheets

    For Each vista As DrawingView In folha.DrawingViews

        Try

            Dim doc =
                vista.ReferencedDocumentDescriptor.ReferencedDocument

            If doc Is Nothing Then Continue For

            Dim caminho As String =
                doc.FullFileName

            If Not mapaDeReferencias.ContainsKey(caminho) Then

                mapaDeReferencias(caminho) =
                    New List(Of String)

            End If

            If Not mapaDeReferencias(caminho).Contains(
                folha.Name) Then

                mapaDeReferencias(caminho).Add(
                    folha.Name)

            End If

        Catch

        End Try

    Next

Next

For Each folha As Sheet In drawingDoc.Sheets

    Dim arquivosReferenciados As New HashSet(
        Of String)(
        StringComparer.OrdinalIgnoreCase)

    For Each vista As DrawingView In folha.DrawingViews

        Try

            Dim doc =
                vista.ReferencedDocumentDescriptor.ReferencedDocument

            If doc IsNot Nothing Then

                arquivosReferenciados.Add(
                    doc.FullFileName)

            End If

        Catch

        End Try

    Next

    Dim status As String

    If arquivosReferenciados.Count = 0 Then

        status = "🚫 Vazia"

    Else

        Dim todasPaginas As New List(Of String)

        For Each arquivo In arquivosReferenciados

            If mapaDeReferencias.ContainsKey(arquivo) Then

                todasPaginas.AddRange(
                    mapaDeReferencias(arquivo))

            End If

        Next

        todasPaginas =
            todasPaginas.
            Distinct().
            OrderBy(Function(n) n).
            ToList()

        If todasPaginas.Count = 1 Then

            status =
                "✔️ Pág: " &
                ExtrairNumeroPagina(
                    todasPaginas(0))

        Else

            Dim paginasFormatadas =
                todasPaginas.
                Select(
                    Function(n)
                        Return ExtrairNumeroPagina(n)
                    End Function).
                ToList()

            status =
                "🔁 Pág: " &
                String.Join(
                    ", ",
                    paginasFormatadas.ToArray())

        End If

    End If

    Dim item As New ListViewItem(
        folha.Name)

    item.SubItems.Add(status)

    Dim qtdePersonalizada As String =
        "-"

    For Each vista As DrawingView In folha.DrawingViews

        Try

            Dim doc =
                vista.ReferencedDocumentDescriptor.ReferencedDocument

            If doc Is Nothing Then Continue For

            Dim props As PropertySet =
                doc.PropertySets.Item(
                    "Inventor User Defined Properties")

            Try

                Dim prop As Inventor.Property =
                    props.Item(
                        "QTDE PERSONALIZADA")

                If prop IsNot Nothing AndAlso
                   prop.Value IsNot Nothing Then

                    qtdePersonalizada =
                        prop.Value.ToString()

                End If

            Catch

            End Try

            Exit For

        Catch

        End Try

    Next

    Dim qtdeFormatada As String =
        qtdePersonalizada

    Dim valorInt As Integer

    If Integer.TryParse(
        qtdePersonalizada,
        valorInt) Then

        qtdeFormatada =
            valorInt.ToString("D2")

    End If

    item.SubItems.Add(
        qtdeFormatada)

    item.Checked = False

    sheetListView.Items.Add(item)

Next

End Sub

'################################################################
' EXTRAI NÚMERO DA PÁGINA
'################################################################

Function ExtrairNumeroPagina(
nome As String) As String

If nome.Contains(":") Then

    Return nome.Substring(
        nome.IndexOf(":") + 1).
        Trim().
        PadLeft(2, "0"c)

End If

Return nome

End Function

'################################################################
' COPIAR FOLHAS
'################################################################

Sub CopiarFolhasSelecionadas(
sheetListView As ListView,
drawingDoc As DrawingDocument)

Dim selectedSheets =
    sheetListView.CheckedItems.
    Cast(Of ListViewItem)().
    Select(Function(i) i.Text).
    ToList()

If selectedSheets.Count = 0 Then

    MessageBox.Show(
        "Selecione ao menos uma folha para copiar.",
        "Aviso",
        MessageBoxButtons.OK,
        MessageBoxIcon.Warning)

    Return

End If

Dim browserPane As BrowserPane =
    GetBrowserPane(drawingDoc)

If browserPane Is Nothing Then

    MessageBox.Show(
        "Não foi possível acessar o painel do navegador de folhas.",
        "Erro",
        MessageBoxButtons.OK,
        MessageBoxIcon.Error)

    Return

End If

Dim tempDrawingDoc As DrawingDocument = Nothing

Dim oSheets As Sheets =
    drawingDoc.Sheets

Dim mapOrigToCopy As New Dictionary(
    Of Sheet,
    Sheet)

For Each nome In selectedSheets

    Try

        Dim shOrig As Sheet =
            oSheets.Item(nome)

        If tempDrawingDoc Is Nothing Then

            tempDrawingDoc =
                CType(
                    ThisApplication.Documents.Add(
                        DocumentTypeEnum.kDrawingDocumentObject,
                        ,
                        False),
                    DrawingDocument)

        End If

        Dim tempSheet As Sheet = Nothing

        Try

            tempSheet =
                shOrig.CopyTo(
                    tempDrawingDoc)

        Catch

            tempSheet = Nothing

        End Try

        Dim shCopia As Sheet = Nothing

        If tempSheet IsNot Nothing Then

            Try

                shCopia =
                    tempSheet.CopyTo(
                        drawingDoc)

            Catch

                shCopia = Nothing

            End Try

        End If

        If shCopia Is Nothing Then

            Try

                Dim qtdAntes As Integer =
                    oSheets.Count

                shOrig.CopyTo(oSheets)

                For j As Integer =
                    qtdAntes + 1 To oSheets.Count

                    Dim tempSh As Sheet =
                        oSheets.Item(j)

                    If tempSh.Name <>
                       shOrig.Name Then

                        shCopia =
                            tempSh

                        Exit For

                    End If

                Next

                If shCopia Is Nothing Then

                    MessageBox.Show(
                        "Não foi possível localizar a cópia de: " &
                        nome,
                        "Erro",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Error)

                    Continue For

                End If

            Catch ex3 As Exception

                MessageBox.Show(
                    "Erro ao copiar folha '" &
                    nome &
                    "': " &
                    ex3.Message,
                    "Erro",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error)

                Continue For

            End Try

        End If

        mapOrigToCopy.Add(
            shOrig,
            shCopia)

    Catch ex As Exception

        MessageBox.Show(
            "Erro inesperado ao copiar '" &
            nome &
            "': " &
            ex.Message,
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)

    End Try

Next

If tempDrawingDoc IsNot Nothing Then

    Try
        tempDrawingDoc.Close(True)
    Catch
    End Try

End If

For Each kvp In mapOrigToCopy

    Try

        Dim nodeOrig =
            browserPane.GetBrowserNodeFromObject(
                kvp.Key)

        Dim nodeCopia =
            browserPane.GetBrowserNodeFromObject(
                kvp.Value)

        If nodeOrig IsNot Nothing AndAlso
           nodeCopia IsNot Nothing Then

            browserPane.Reorder(
                nodeOrig,
                False,
                nodeCopia)

        End If

    Catch ex As Exception

        MessageBox.Show(
            "Erro ao reposicionar cópia de '" &
            kvp.Key.Name &
            "': " &
            ex.Message,
            "Aviso",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)

    End Try

Next

drawingDoc.Update()

MessageBox.Show(
    "Folhas copiadas com sucesso.",
    "Sucesso",
    MessageBoxButtons.OK,
    MessageBoxIcon.Information)

End Sub

