'################################################################
' ESCALA DA VISTA DOBRADA
'################################################################

Private Function CalcularEscalaIdeal(
compDef As ComponentDefinition) As Double

Try

    Dim oBox As Box =
        compDef.RangeBox

    Dim largura As Double =
        Math.Abs(
            oBox.MaxPoint.X -
            oBox.MinPoint.X)

    Dim altura As Double =
        Math.Abs(
            oBox.MaxPoint.Y -
            oBox.MinPoint.Y)

    Dim profundidade As Double =
        Math.Abs(
            oBox.MaxPoint.Z -
            oBox.MinPoint.Z)

    Dim tamanhoMaximo As Double =
        Math.Max(
            largura,
            Math.Max(
                altura,
                profundidade)) * 10

    Dim areaUtil As Double =
        180

    Dim escala As Double =
        areaUtil / tamanhoMaximo

    If escala >= 1 Then Return 1

    If escala >= 0.5 Then Return 0.5

    If escala >= 0.2 Then Return 0.2

    If escala >= 0.1 Then Return 0.1

    Return 0.05

Catch

    Return 1

End Try

End Function

'################################################################
' ORDENAR TREEVIEW
'################################################################

Sub OrdenarTreeNodes(
nodes As TreeNodeCollection)

Dim lista As New List(Of TreeNode)

For Each node As TreeNode In nodes
    lista.Add(node)
Next

lista.Sort(
    Function(a, b)

        Return CompararHierarquia(
            a.Name,
            b.Name)

    End Function)

nodes.Clear()

For Each node As TreeNode In lista

    nodes.Add(node)

    If node.Nodes.Count > 0 Then

        OrdenarTreeNodes(
            node.Nodes)

    End If

Next

End Sub

'################################################################
' COMPARAR HIERARQUIA
'################################################################

Function CompararHierarquia(
a As String,
b As String) As Integer

Dim partesA() As String =
    a.Split("."c)

Dim partesB() As String =
    b.Split("."c)

Dim maxLength As Integer =
    Math.Max(
        partesA.Length,
        partesB.Length)

For i As Integer =
    0 To maxLength - 1

    Dim valorA As Integer =
        If(
            i < partesA.Length,
            Integer.Parse(partesA(i)),
            0)

    Dim valorB As Integer =
        If(
            i < partesB.Length,
            Integer.Parse(partesB(i)),
            0)

    Dim resultado As Integer =
        valorA.CompareTo(valorB)

    If resultado <> 0 Then
        Return resultado
    End If

Next

Return 0

End Function

'################################################################
' INSERIR VISTA
'################################################################

Sub InsertBaseViewUsingCopiedSheet(
drawingDoc As DrawingDocument,
partPath As String,
itemNumber As String,
labelNumber As String,
arquivosComVistas As HashSet(Of String))

If arquivosComVistas.Contains(partPath) Then
    Return
End If

Dim partDoc As Document = Nothing

Try

    Try

        partDoc =
            ThisApplication.Documents.Open(
                partPath,
                False)

    Catch ex As Exception

        MessageBox.Show(
            "Erro ao abrir arquivo:" &
            vbCrLf &
            partPath &
            vbCrLf &
            ex.Message,
            "Erro",
            MessageBoxButtons.OK,
            MessageBoxIcon.Error)

        Return

    End Try

    '=====================================================
    ' NOVA FOLHA A3
    '=====================================================

    Dim novaFolha As Sheet =
        drawingDoc.Sheets.Add(
            DrawingSheetSizeEnum.kA3DrawingSheetSize,
            PageOrientationTypeEnum.kLandscapePageOrientation,
            SanitizarNomeFolha(
                itemNumber &
                " – " &
                labelNumber))

    novaFolha.Activate()

    '=====================================================
    ' MARGEM
    '=====================================================

    Dim nomeMargem As String =
        "FOLHA DOMA/LIGA"

    Dim margemDef As BorderDefinition = Nothing

    Try

        margemDef =
            drawingDoc.BorderDefinitions.Item(
                nomeMargem)

    Catch

        margemDef = Nothing

    End Try

    If margemDef IsNot Nothing Then

        Try

            If novaFolha.Border IsNot Nothing Then
                novaFolha.Border.Delete()
            End If

            novaFolha.AddBorder(
                margemDef)

        Catch ex As Exception

            MessageBox.Show(
                "Não foi possível adicionar a margem '" &
                nomeMargem &
                "'." &
                vbCrLf &
                ex.Message,
                "Margem",
                MessageBoxButtons.OK,
                MessageBoxIcon.Warning)

        End Try

    End If

    '=====================================================
    ' BLOCO DE TÍTULO
    '=====================================================

    Dim nomeNovaLegenda As String =
        "SELO DOMA/LIGA"

    Dim oTitleBlockDef As TitleBlockDefinition =
        Nothing

    Try

        oTitleBlockDef =
            drawingDoc.TitleBlockDefinitions.Item(
                nomeNovaLegenda)

    Catch

        oTitleBlockDef = Nothing

    End Try

    If oTitleBlockDef IsNot Nothing Then

        Try

            If novaFolha.TitleBlock IsNot Nothing Then
                novaFolha.TitleBlock.Delete()
            End If

            novaFolha.AddTitleBlock(
                oTitleBlockDef)

        Catch ex As Exception

            MessageBox.Show(
                "Não foi possível adicionar a legenda '" &
                nomeNovaLegenda &
                "'." &
                vbCrLf &
                ex.Message,
                "Bloco de Título",
                MessageBoxButtons.OK,
                MessageBoxIcon.Warning)

        End Try

    End If

    '=====================================================
    ' ESCALA VISTA DOBRADA
    '=====================================================

    Dim escalaDobrada As Double = 1

    If TypeOf partDoc Is PartDocument Then

        escalaDobrada =
            CalcularEscalaIdeal(
                CType(
                    partDoc,
                    PartDocument).
                ComponentDefinition)

    ElseIf TypeOf partDoc Is AssemblyDocument Then

        escalaDobrada =
            CalcularEscalaIdeal(
                CType(
                    partDoc,
                    AssemblyDocument).
                ComponentDefinition)

    End If

    Dim tg As TransientGeometry =
        ThisApplication.TransientGeometry

    Dim posDobrada As Point2d =
        tg.CreatePoint2d(
            novaFolha.Width / 4,
            novaFolha.Height / 2)

    '=====================================================
    ' VISTA DOBRADA
    '=====================================================

    Dim vistaDobrada As DrawingView =
        novaFolha.DrawingViews.AddBaseView(
            partDoc,
            posDobrada,
            escalaDobrada,
            ViewOrientationTypeEnum.kDefaultViewOrientation,
            DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle)

    vistaDobrada.DisplayTangentEdges = True

    '=====================================================
    ' SHEET METAL
    '=====================================================

    If Not TypeOf partDoc Is PartDocument Then

        partDoc.Close(False)
        Return

    End If

    Dim smDef As SheetMetalComponentDefinition =
        Nothing

    Try

        If TypeOf CType(
            partDoc,
            PartDocument).
            ComponentDefinition Is SheetMetalComponentDefinition Then

            smDef =
                CType(
                    CType(
                        partDoc,
                        PartDocument).
                        ComponentDefinition,
                    SheetMetalComponentDefinition)

        Else

            partDoc.Close(False)
            Return

        End If

    Catch

        partDoc.Close(False)
        Return

    End Try

    If smDef.Bends.Count = 0 Then

        partDoc.Close(False)
        Return

    End If

    '=====================================================
    ' FLAT PATTERN
    '=====================================================

    Try

        If Not smDef.HasFlatPattern Then
            smDef.Unfold()
        End If

    Catch ex As Exception

        MessageBox.Show(
            "Não foi possível criar planificação:" &
            vbCrLf &
            ex.Message,
            "Sheet Metal",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning)

        partDoc.Close(False)
        Return

    End Try

    '=====================================================
    ' ANALISAR ORIENTAÇÃO
    '=====================================================

    Dim flatPattern As FlatPattern =
        smDef.FlatPattern

    Dim qtdUp As Integer = 0

    Dim qtdDown As Integer = 0

    Try

        For Each bendResult As FlatBendResult In
            flatPattern.FlatBendResults

            If bendResult.IsOnBottomFace Then
                Continue For
            End If

            If bendResult.IsDirectionUp Then

                qtdUp += 1

            Else

                qtdDown += 1

            End If

        Next

    Catch

    End Try

    If qtdDown > qtdUp Then

        Try

            Dim orientation As FlatPatternOrientation =
                flatPattern.
                FlatPatternOrientations.
                ActiveFlatPatternOrientation

            orientation.FlipBaseFace =
                Not orientation.FlipBaseFace

        Catch

            Try

                Dim novaFace As Face =
                    FindOppositePlanarFace(
                        flatPattern)

                If novaFace IsNot Nothing Then

                    smDef.Unfold2(
                        novaFace)

                    flatPattern =
                        smDef.FlatPattern

                End If

            Catch

            End Try

        End Try

    End If

    Try
        CType(
            partDoc,
            PartDocument).Update()
    Catch
    End Try

    '=====================================================
    ' ESCALA FLAT
    '=====================================================

    Dim escalaFlat As Double =
        CalcularEscalaFlatPattern(
            smDef)

    Dim posFlat As Point2d =
        tg.CreatePoint2d(
            posDobrada.X,
            posDobrada.Y)

    Dim options As NameValueMap =
        ThisApplication.TransientObjects.
        CreateNameValueMap()

    options.Add(
        "SheetMetalFoldedModel",
        False)

    Dim vistaPlanificada As DrawingView =
        novaFolha.DrawingViews.AddBaseView(
            partDoc,
            posFlat,
            escalaFlat,
            ViewOrientationTypeEnum.kDefaultViewOrientation,
            DrawingViewStyleEnum.kHiddenLineRemovedDrawingViewStyle,
            "",
            Nothing,
            options)

    vistaPlanificada.DisplayTangentEdges = True

    drawingDoc.Update()

    '=====================================================
    ' BEND NOTES
    '=====================================================

    Dim tolerancia As Double =
        0.01

    Dim pontosProcessados As New List(Of Point2d)

    Dim bendCurves As New List(Of DrawingCurve)

    For Each curve As DrawingCurve In
        vistaPlanificada.DrawingCurves

        If curve.EdgeType =
           DrawingEdgeTypeEnum.kBendUpEdge OrElse
           curve.EdgeType =
           DrawingEdgeTypeEnum.kBendDownEdge Then

            bendCurves.Add(curve)

        End If

    Next

    For Each curve As DrawingCurve In bendCurves

        Try

            Dim Mid As Point2d =
                curve.MidPoint

            Dim duplicada As Boolean = False

            For Each ponto As Point2d In
                pontosProcessados

                Dim dx As Double =
                    Mid.X - ponto.X

                Dim dy As Double =
                    Mid.Y - ponto.Y

                Dim distancia As Double =
                    Math.Sqrt(
                        dx * dx +
                        dy * dy)

                If distancia <= tolerancia Then

                    duplicada = True
                    Exit For

                End If

            Next

            If duplicada Then
                Continue For
            End If

            Dim bendNote As BendNote =
                novaFolha.DrawingNotes.
                BendNotes.Add(curve)

            bendNote.Position =
                tg.CreatePoint2d(
                    Mid.X,
                    Mid.Y)

            pontosProcessados.Add(
                tg.CreatePoint2d(
                    Mid.X,
                    Mid.Y))

        Catch

        End Try

    Next

    drawingDoc.Update()

    Try
        partDoc.Close(False)
    Catch
    End Try

Catch ex As Exception

    MessageBox.Show(
        "Erro ao inserir vista:" &
        vbCrLf &
        ex.Message,
        "Erro",
        MessageBoxButtons.OK,
        MessageBoxIcon.Error)

    Try

        If partDoc IsNot Nothing Then
            partDoc.Close(False)
        End If

    Catch

    End Try

End Try

End Sub

'################################################################
' FACE OPOSTA
'################################################################

Private Function FindOppositePlanarFace(
flatPattern As FlatPattern) As Face

Try

    For Each bendResult As FlatBendResult In
        flatPattern.FlatBendResults

        If bendResult.IsOnBottomFace Then

            Try

                For Each backFace As Face In
                    bendResult.Bend.BackFaces

                    For Each connectedFace As Face In
                        backFace.TangentiallyConnectedFaces

                        If connectedFace.SurfaceType =
                           SurfaceTypeEnum.kPlaneSurface Then

                            Return connectedFace

                        End If

                    Next

                Next

            Catch

            End Try

        End If

    Next

Catch

    Return Nothing

End Try

Return Nothing

End Function

'################################################################
' ESCALA FLAT PATTERN
'################################################################

Private Function CalcularEscalaFlatPattern(
smDef As SheetMetalComponentDefinition) As Double

Try

    If Not smDef.HasFlatPattern Then
        smDef.Unfold()
    End If

    Dim flatBox As Box =
        smDef.FlatPattern.RangeBox

    Dim largura As Double =
        Math.Abs(
            flatBox.MaxPoint.X -
            flatBox.MinPoint.X)

    Dim altura As Double =
        Math.Abs(
            flatBox.MaxPoint.Y -
            flatBox.MinPoint.Y)

    Dim tamanhoMaximo As Double =
        Math.Max(
            largura,
            altura) * 10

    Dim areaUtil As Double =
        180

    Dim escala As Double =
        areaUtil / tamanhoMaximo

    If escala >= 1 Then Return 1

    If escala >= 0.5 Then Return 0.5

    If escala >= 0.2 Then Return 0.2

    If escala >= 0.1 Then Return 0.1

    If escala >= 0.05 Then Return 0.05

    Return 0.02

Catch

    Return 0.1

End Try

End Function

'################################################################
' SANITIZAR NOME DA FOLHA
'################################################################

Function SanitizarNomeFolha(
nomeOriginal As String) As String

Dim caracteresInvalidos As Char() = {
    "<"c,
    ">"c,
    ":"c,
    """"c,
    "/"c,
    "\"c,
    "|"c,
    "?"c,
    "*"c,
    ","c
}

For Each c In caracteresInvalidos

    nomeOriginal =
        nomeOriginal.Replace(
            c,
            "."c)

Next

Return nomeOriginal.Trim()

End Function

