' ============================================================
' ADICIONAR OBJETOS RECURSIVAMENTE
' ============================================================

Sub AdicionarObjetosRecursivos(
    obj As Object,
    lista As List(Of Object))


    If obj Is Nothing Then
        Return
    End If


    lista.Add(
        obj)


    Dim item As BOMItem =
        TryCast(
            obj,
            BOMItem)


    If item Is Nothing Then
        Return
    End If


    If item.Filhos Is Nothing Then
        Return
    End If


    For Each filho As BOMItem
        In item.Filhos


        AdicionarObjetosRecursivos(
            filho,
            lista)


    Next


End Sub


' ============================================================
' SHIFT - TREELISTVIEW
' ============================================================

Sub SelecionarIntervaloTreeListView(
    listView As TreeListView,
    primeiro As OLVListItem,
    ultimo As OLVListItem)


    If primeiro Is Nothing OrElse
       ultimo Is Nothing Then

        Return

    End If


    Dim indiceInicial As Integer =
        primeiro.Index


    Dim indiceFinal As Integer =
        ultimo.Index


    If indiceInicial > indiceFinal Then


        Dim temp As Integer =
            indiceInicial


        indiceInicial =
            indiceFinal


        indiceFinal =
            temp


    End If


    For i As Integer =
        indiceInicial To indiceFinal


        If i >= 0 AndAlso
           i < listView.Items.Count Then


            Dim item As OLVListItem =
                listView.Items(i)


            If Not listView.CheckedObjects.Contains(
                item.RowObject) Then


                Dim objetosAtuais As New List(Of Object)


                For Each obj As Object
                    In listView.CheckedObjects

                    objetosAtuais.Add(
                        obj)

                Next


                objetosAtuais.Add(
                    item.RowObject)


                listView.CheckedObjects =
                    objetosAtuais


            End If


        End If


    Next


End Sub


